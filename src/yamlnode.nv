// yamlnode.nv — the value tree, and the scalar resolution that decides
// what a bare word means.
//
// YAML 1.2 defines three schemas (section 10).  The failsafe schema has
// only strings, sequences and mappings.  The JSON schema adds null,
// boolean, integer and float with JSON's spellings.  The core schema,
// the default, adds the other spellings people write: `True`, `NULL`,
// `~`, `0o17`, `0x1F`, `.inf` and `.NaN`.  `yes` and `no` are not among
// them, so under the core schema `no` is the string `"no"`.  YAML 1.1
// read `no` as false; that reading is `SchemaLegacy11`, for files
// written for a 1.1 loader.
//
// Nothing here resolves a tag by looking something up.  A tag outside
// the core schema is refused by the reader, as `yamlsafe` decides.
//
// A mapping is an ordered list of pairs whose keys are nodes.  Ordered,
// so a document read and written again comes back in the order it was
// written.  Keys are nodes because YAML permits a sequence or a mapping
// as a key, `? [a, b]`.  `yamlkeys`' paths walk string keys only, and
// `pairs_of` reaches the rest.

use std.str
use std.list

// A YAML node: the core schema's six kinds and nothing else.
//
// There is no `YamlTagged` arm.  A tag that survives `yamlsafe`'s
// policy has resolved to one of these; a tag that does not is a
// refusal.  Keeping an unresolved tag in the tree would push the
// safety decision onto every consumer, which is exactly the mistake
// that makes YAML loaders unsafe.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     println(yamlnode.kind_name(YamlInt(8080)))    // int
// ```
pub enum YamlValue
    // A mapping: its pairs in the order the document wrote them.
    // Block and flow mappings are the same value; which one it was is
    // a spelling the writer chooses.
    YamlMap(pairs: [YamlPair])
    // A sequence.  Block and flow sequences are again the same value.
    YamlSeq(items: [YamlValue])
    // A string, already unescaped, with block scalar folding and
    // chomping applied.
    YamlStr(value: Str)
    // A signed 64-bit integer.  The core schema's forms: decimal with
    // an optional sign, `0o` octal, `0x` hex.  A literal outside the
    // range resolves to a string rather than wrapping, because that
    // is what the schema says an unresolvable scalar is.
    YamlInt(value: Int)
    // A 64-bit float, including `.inf`, `-.inf` and `.nan`.
    YamlFloat(value: Float)
    // `true` or `false`, in the core schema's spellings only.
    YamlBool(value: Bool)
    // The null node: `null`, `Null`, `NULL`, `~`, and the empty
    // scalar.  A distinct arm rather than an absence, because YAML
    // distinguishes `a:` — which binds `a` to null — from a document
    // in which `a` does not appear, and a caller checking a config
    // file for an explicitly blanked setting needs the difference.
    YamlNull

// One key and its value, in document order.
//
// `key` is a `YamlValue` because YAML permits a collection as a key.
// In practice it is almost always `YamlStr`, and `yamlkeys.str_key_of`
// is the shortcut for a caller that only handles those.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     let p = YamlPair { key: YamlStr("port"), value: YamlInt(8080) }
//     println(yamlnode.kind_name(p.key))            // str
// ```
pub struct YamlPair
    // The key node, resolved by the same rules as any other scalar —
    // so `1: a` has an INTEGER key, which is a thing YAML documents do
    // and a `Str`-keyed tree would have silently stringified.
    key: YamlValue
    // What it is bound to.
    value: YamlValue

// Which arm a node is, as a value a caller can match or print.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     match yamlnode.kind_of(YamlNull)
//         KindNull => println("null")
//         _        => println("something else")
// ```
pub enum YamlKind
    KindMap
    KindSeq
    KindStr
    KindInt
    KindFloat
    KindBool
    KindNull

// Which of YAML 1.2's schemas resolves a bare scalar.
//
// The default everywhere in this package is `SchemaCore`.  The other
// two are here because a caller sometimes has to read a file written
// for a different reader, and choosing that should be visible at the
// call site rather than hidden in a flag.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     match yamlnode.resolve("no", SchemaCore)
//         YamlStr(s) => println(s)          // no — 1.2 keeps Norway
//         _          => println("resolved to something else")
// ```
pub enum YamlSchema
    // Strings, sequences and mappings, and nothing else resolves.
    // Every scalar is a `YamlStr`.  It is the schema for a caller
    // that wants no surprises at all — a templating tool, a diff, a
    // formatter.
    SchemaFailsafe
    // JSON's types with JSON's spellings: `null`, `true`, `false`,
    // decimal integers, decimal floats, and nothing else.
    SchemaJson
    // YAML 1.2 § 10.3: JSON's, plus `Null`/`NULL`/`~`, `True`/`TRUE`,
    // `0o` and `0x` integers, `.inf` and `.nan`.  `no`, `off` and `y`
    // are strings.  The default.
    SchemaCore
    // YAML 1.1's boolean set, in which `yes`, `no`, `on` and `off`
    // resolve to booleans and a sexagesimal `1:30` resolves to 90.
    // For reading files written for a 1.1 loader.  It is named
    // `SchemaLegacy11` and not `SchemaCompat` so that a reader of the
    // call site knows what they are opting into: this is the schema
    // in which the country Norway becomes `false`.
    SchemaLegacy11

// The kind of a node.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     match yamlnode.kind_of(YamlSeq([]))
//         KindSeq => println("sequence")
//         _       => println("not a sequence")
// ```
pub fn kind_of(v: YamlValue) -> YamlKind
    match v
        YamlMap(_)   => KindMap
        YamlSeq(_)   => KindSeq
        YamlStr(_)   => KindStr
        YamlInt(_)   => KindInt
        YamlFloat(_) => KindFloat
        YamlBool(_)  => KindBool
        YamlNull     => KindNull

// The kind's name in the spelling YAML's own specification uses:
// `"map"`, `"seq"`, `"str"`, `"int"`, `"float"`, `"bool"`, `"null"`.
//
// These are the strings `WrongKind` carries, so an error message and a
// hand-written one say the same words.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     println(yamlnode.kind_name(YamlFloat(1.5)))   // float
// ```
pub fn kind_name(v: YamlValue) -> Str
    match v
        YamlMap(_)   => "map"
        YamlSeq(_)   => "seq"
        YamlStr(_)   => "str"
        YamlInt(_)   => "int"
        YamlFloat(_) => "float"
        YamlBool(_)  => "bool"
        YamlNull     => "null"

// Resolve a plain scalar's text to a node, under a schema.
//
// Only plain scalars are resolved: a quoted scalar is a string whatever
// it spells, which is how a YAML author says "I mean the text".  An
// integer outside the 64-bit range resolves to a string rather than
// wrapping, since the schema makes an unresolvable scalar a string.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     match yamlnode.resolve("0o17", SchemaCore)
//         YamlInt(n) => println("${n}")     // 15
//         _          => println("not an integer")
// ```
pub fn resolve(text: Str, schema: YamlSchema) -> YamlValue
    match schema
        SchemaFailsafe => YamlStr(text)
        SchemaJson     => resolve_json(text)
        SchemaCore     => resolve_core(text)
        SchemaLegacy11 => resolve_11(text)

// How many pairs a mapping has, or how many items a sequence has.
//
// `0` for a scalar and for null, because "how long is this integer"
// has no better answer.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     println("${yamlnode.len(YamlSeq([YamlInt(1), YamlInt(2)]))}")   // 2
// ```
pub fn len(v: YamlValue) -> Int
    match v
        YamlMap(pairs) => list.len(pairs)
        YamlSeq(items) => list.len(items)
        _              => 0

// A mapping's pairs, in document order.
//
// An empty list for anything that is not a mapping.  It is the escape
// hatch for the documents `yamlkeys`' string paths cannot reach — a
// mapping keyed by sequences, an integer-keyed table — and it is here
// so that such a document is awkward rather than unreadable.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     let m = YamlMap(pairs: [
//         YamlPair { key: YamlInt(1), value: YamlStr("one") }])
//     println("${list.len(yamlnode.pairs_of(m))}")   // 1
// ```
pub fn pairs_of(v: YamlValue) -> [YamlPair]
    match v
        YamlMap(pairs) => pairs[:]
        _              => []

// A sequence's items, in order.
//
// An empty list for anything that is not a sequence.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     println("${list.len(yamlnode.items_of(YamlSeq([YamlNull])))}")  // 1
// ```
pub fn items_of(v: YamlValue) -> [YamlValue]
    match v
        YamlSeq(items) => items[:]
        _              => []

// Two nodes compared structurally: same arm, same contents, and for
// mappings the same pairs in the same order.
//
// Order-sensitive because these are documents.  Two files binding the
// same keys in a different order are different files, a formatter that
// reordered them would be wrong, and a round-trip test needs the
// strict answer.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     println("${yamlnode.equal(YamlNull, YamlNull)}")   // true
// ```
pub fn equal(a: YamlValue, b: YamlValue) -> Bool
    match a
        YamlMap(pa)  =>
            match b
                YamlMap(pb) => pairs_equal(pa, pb)
                _           => false
        YamlSeq(ia)  =>
            match b
                YamlSeq(ib) => items_equal(ia, ib)
                _           => false
        YamlStr(x)   =>
            match b
                YamlStr(y) => x == y
                _          => false
        YamlInt(x)   =>
            match b
                YamlInt(y) => x == y
                _          => false
        YamlFloat(x) =>
            match b
                YamlFloat(y) => x == y or x != x and y != y
                _            => false
        YamlBool(x)  =>
            match b
                YamlBool(y) => x == y
                _           => false
        YamlNull     =>
            kind_of(b) == KindNull

// The nesting depth of a node: `0` for a scalar, `1` for a collection
// of scalars, and so on.
//
// `yamlsafe`'s depth budget is measured in these, and a caller about
// to hand a tree to something with a recursion limit of its own uses
// this to find out first.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     println("${yamlnode.depth(YamlSeq([YamlSeq([])]))}")   // 2
// ```
pub fn depth(v: YamlValue) -> Int
    match v
        YamlMap(pairs) =>
            var most = 0
            for p in pairs
                let d = max_int(depth(p.key), depth(p.value))
                if d > most
                    most = d
            most + 1
        YamlSeq(items) =>
            var most = 0
            for x in items
                let d = depth(x)
                if d > most
                    most = d
            most + 1
        _              =>
            0

// How many nodes a tree holds, counting every scalar and every
// collection.
//
// The unit `yamlsafe`'s expansion budget is denominated in, so a
// caller can compare a document it already holds against the budget it
// is about to set.
//
// ```novo
// use yamlnode
//
// fn main() [io]
//     println("${yamlnode.node_count(YamlSeq([YamlInt(1)]))}")   // 2
// ```
pub fn node_count(v: YamlValue) -> Int
    match v
        YamlMap(pairs) =>
            var n = 1
            for p in pairs
                n = n + node_count(p.key) + node_count(p.value)
            n
        YamlSeq(items) =>
            var n = 1
            for x in items
                n = n + node_count(x)
            n
        _              =>
            1

// ── Resolution ────────────────────────────────────────────────────────

fn max_int(a: Int, b: Int) -> Int
    if a > b
        a
    else
        b

fn pairs_equal(a: [YamlPair], b: [YamlPair]) -> Bool
    if list.len(a) != list.len(b)
        return false
    for i in 0..list.len(a)
        if not equal(a[i].key, b[i].key) or not equal(a[i].value, b[i].value)
            return false
    true

fn items_equal(a: [YamlValue], b: [YamlValue]) -> Bool
    if list.len(a) != list.len(b)
        return false
    for i in 0..list.len(a)
        if not equal(a[i], b[i])
            return false
    true

fn one_of(text: Str, words: [Str]) -> Bool
    list.contains(words, text)

fn is_digit(b: Int) -> Bool
    b >= '0' and b <= '9'

// Whether every byte of `text` from `from` is a digit of `base`, and
// there is at least one.
fn digits(text: Str, from: Int, base: Int) -> Bool
    let n = str.len(text)
    if from >= n
        return false
    for i in from..n
        if digit_value(str.byte_at_or(text, i, 0)) >= base
            return false
    true

fn digit_value(b: Int) -> Int
    if is_digit(b)
        b - '0'
    elif b >= 'a' and b <= 'f'
        b - 'a' + 10
    elif b >= 'A' and b <= 'F'
        b - 'A' + 10
    else
        99

// The integer `text[from:]` spells in `base`, negated when `negative`,
// or `None` when it does not fit in 64 bits.
fn integer(text: Str, from: Int, base: Int, negative: Bool) -> ?Int
    // Accumulated as a negative number, which reaches one further than
    // a positive one, so the most negative integer is representable.
    var v = 0
    let floor = -9223372036854775807 - 1
    for i in from..str.len(text)
        let d = digit_value(str.byte_at_or(text, i, 0))
        if v < (floor + d) / base
            return None
        v = v * base - d
    if negative
        return Some(v)
    if v == floor
        return None
    Some(0 - v)

// The float a decimal spelling means: an optional sign, digits with an
// optional point, and an optional exponent, with a digit on at least one
// side of the point.
fn decimal_float(text: Str) -> ?Float
    let n = str.len(text)
    var i = 0
    let sign = str.byte_at_or(text, 0, 0)
    if sign == '+' or sign == '-'
        i = 1
    var before = 0
    for _ in i..n
        if not is_digit(str.byte_at_or(text, i, 0))
            break
        i = i + 1
        before = before + 1
    var after = 0
    if str.byte_at_or(text, i, 0) == '.'
        i = i + 1
        for _ in i..n
            if not is_digit(str.byte_at_or(text, i, 0))
                break
            i = i + 1
            after = after + 1
    if before + after == 0
        return None
    let e = str.byte_at_or(text, i, 0)
    if e == 'e' or e == 'E'
        var k = i + 1
        let es = str.byte_at_or(text, k, 0)
        if es == '+' or es == '-'
            k = k + 1
        if not digits(text, k, 10)
            return None
        i = n
    if i != n
        return None
    // `str.to_float` reads C's spelling, which wants a digit before the
    // point and none of a leading `+`.
    var body = if sign == '+'
        str.slice(text, 1, n)
    else
        text
    body = str.replace(body, "-.", "-0.")
    if str.starts_with(body, ".")
        body = "0" + body
    str.to_float(body)

fn special_float(text: Str, legacy: Bool) -> ?Float
    let t = if str.starts_with(text, "+")
        str.slice(text, 1, str.len(text))
    else
        text
    if one_of(t, [".inf", ".Inf", ".INF"])
        return Some(1.0 / 0.0)
    if one_of(t, ["-.inf", "-.Inf", "-.INF"])
        return Some(-1.0 / 0.0)
    if one_of(text, [".nan", ".NaN", ".NAN"])
        return Some(0.0 / 0.0)
    None

fn resolve_core(text: Str) -> YamlValue
    if one_of(text, ["", "~", "null", "Null", "NULL"])
        return YamlNull
    if one_of(text, ["true", "True", "TRUE"])
        return YamlBool(true)
    if one_of(text, ["false", "False", "FALSE"])
        return YamlBool(false)
    if str.starts_with(text, "0o") and digits(text, 2, 8)
        return int_or_str(text, integer(text, 2, 8, false))
    if str.starts_with(text, "0x") and digits(text, 2, 16)
        return int_or_str(text, integer(text, 2, 16, false))
    let sign = str.byte_at_or(text, 0, 0)
    let from = if sign == '+' or sign == '-'
        1
    else
        0
    if digits(text, from, 10)
        return int_or_str(text, integer(text, from, 10, sign == '-'))
    float_or_str(text, false)

fn resolve_json(text: Str) -> YamlValue
    if text == "null"
        return YamlNull
    if text == "true"
        return YamlBool(true)
    if text == "false"
        return YamlBool(false)
    let from = if str.starts_with(text, "-")
        1
    else
        0
    let lead = str.byte_at_or(text, from, 0)
    let second = str.byte_at_or(text, from + 1, 0)
    if lead == '0' and is_digit(second)
        return YamlStr(text)
    if digits(text, from, 10)
        return int_or_str(text, integer(text, from, 10, from == 1))
    if str.starts_with(text, "+") or str.starts_with(text, ".") or str.starts_with(text, "-.")
            or str.contains(text, ".e") or str.contains(text, ".E") or str.ends_with(text, ".")
        return YamlStr(text)
    match decimal_float(text)
        Some(f) => YamlFloat(f)
        None    => YamlStr(text)

fn resolve_11(text: Str) -> YamlValue
    if one_of(text, ["", "~", "null", "Null", "NULL"])
        return YamlNull
    if one_of(text, ["y", "Y", "yes", "Yes", "YES", "true", "True", "TRUE", "on", "On", "ON"])
        return YamlBool(true)
    if one_of(text, ["n", "N", "no", "No", "NO", "false", "False", "FALSE", "off", "Off", "OFF"])
        return YamlBool(false)
    let plain = str.replace_all(text, "_", "")
    let sign = str.byte_at_or(plain, 0, 0)
    let from = if sign == '+' or sign == '-'
        1
    else
        0
    let negative = sign == '-'
    let body = str.slice(plain, from, str.len(plain))
    if str.starts_with(body, "0b") and digits(body, 2, 2)
        return int_or_str(text, integer(body, 2, 2, negative))
    if str.starts_with(body, "0x") and digits(body, 2, 16)
        return int_or_str(text, integer(body, 2, 16, negative))
    if str.starts_with(body, "0") and str.len(body) > 1 and digits(body, 1, 8)
        return int_or_str(text, integer(body, 1, 8, negative))
    if digits(body, 0, 10)
        return int_or_str(text, integer(body, 0, 10, negative))
    if let Some(v) = sexagesimal(body)
        return YamlInt((if negative then 0 - v else v))
    match decimal_float(plain)
        Some(f) => YamlFloat(f)
        None    =>
            match special_float(text, true)
                Some(f) => YamlFloat(f)
                None    => YamlStr(text)

// YAML 1.1's base 60: `1:30` is 90.  Every part after the first is 0 to
// 59.
fn sexagesimal(body: Str) -> ?Int
    let parts = str.split(body, ":")
    if list.len(parts) < 2
        return None
    var v = 0
    for i in 0..list.len(parts)
        let part = parts[i]
        if not digits(part, 0, 10) or str.len(part) > 12
            return None
        let n = str.to_int(part) ?? 0
        if i > 0 and n > 59
            return None
        v = v * 60 + n
    Some(v)

fn int_or_str(text: Str, v: ?Int) -> YamlValue
    match v
        Some(n) => YamlInt(n)
        None    => YamlStr(text)

fn float_or_str(text: Str, legacy: Bool) -> YamlValue
    match decimal_float(text)
        Some(f) => YamlFloat(f)
        None    =>
            match special_float(text, legacy)
                Some(f) => YamlFloat(f)
                None    => YamlStr(text)
