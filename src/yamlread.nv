// yamlread.nv — the reader: a feed-and-drain state machine, and the
// direct forms written on top of it.
//
// A YAML stream is a sequence of documents, and each one is complete
// when its terminator arrives: a `---` that starts the next, a `...`,
// or the end of the stream.  A document marker at the start of a line
// cannot occur inside any scalar (YAML 1.2 section 9.1.4), so the
// reader splits the stream at those lines and parses each document as
// it completes.  `feed` therefore hands back finished documents while
// the rest of the stream is still arriving:
//
//     let r = yamlread.reader(yamlsafe.standard())
//     let fed = yamlread.feed(r, chunk)       // as many times as you like
//     let rest = yamlread.finish(fed.0)!      // once, at end of stream
//
// A chunk may split anything: a line, a UTF-8 sequence, a `---` between
// its dashes.  The reader carries what it could not finish into the next
// call, and `feed` answers a new reader rather than changing the one it
// was given.
//
// `read_all<S: Read[e]>` is the same machine with the pump written
// once.  `S: Read[e]` binds the effect parameter of the standard
// library's `Read` trait (SPEC section 5.6), so it costs the caller
// what the caller's stream costs, and this package spends nothing.

use std.str
use std.list
use std.bytes
use yamlnode
use yamlsafe
use yamlerror
use yamlparse

// A YAML reader between chunks.
//
// Carried by value: `feed` answers the next one.  A reader that has
// failed stays failed; `error` says why, and every later `feed` yields
// nothing.
//
// ```novo
// use yamlread
// use yamlsafe
//
// fn main() [io]
//     let r = yamlread.reader(yamlsafe.standard())
//     println("${r.line}")                      // 1
// ```
pub struct YamlReader
    // The policy this reader was built with, unchanged.
    limits: YamlLimits
    // The 1-based stream line of the first byte not yet read as a
    // complete line.
    line: Int
    // How many documents have been emitted so far in this stream.
    doc_index: Int
    // The bytes of the current line not yet ended, carried across a
    // chunk boundary.
    partial: Str
    // The trailing bytes of a UTF-8 sequence a chunk ended inside.
    pending: [Int]
    // Whether a document is open: a `---` has started one, or content
    // has.
    in_doc: Bool
    // The lines of the open document so far.
    doc_lines: [Str]
    // The stream line of the open document's first line.
    doc_line: Int
    // Whether the open document began with a `---` line.
    marked: Bool
    // The directives read since the last document, `%YAML` and `%TAG`.
    directives: [Str]
    // The anchors the most recently completed document defined, in
    // the order it defined them.  An anchor is scoped to its document
    // (section 3.2.2.2), so the next document starts with none.
    anchors: [Str]
    // The sticky failure, or `None`.
    failure: ?YamlError

// A reader at the start of a stream.
//
// A policy with a negative budget does not fail here: a constructor
// has no error channel.  The first document that reaches the budget is
// refused, and `error` says which.
//
// ```novo
// use yamlread
// use yamlsafe
//
// fn main() [io]
//     let r = yamlread.reader(yamlsafe.hardened())
//     match yamlread.error(r)
//         Some(_) => println("bad policy")
//         None    => println("ready")
// ```
pub fn reader(p: YamlLimits) -> YamlReader
    YamlReader { limits: p, line: 1, doc_index: 0, partial: "", pending: [], in_doc: false,
                 doc_lines: [], doc_line: 1, marked: false, directives: [], anchors: [],
                 failure: None }

// Feed the next chunk; get back the reader to feed the chunk after it,
// and every document those bytes completed.
//
// A document is complete when a `---` or `...` terminator or the end
// of the stream closes it.  A chunk that ends mid-document produces
// nothing for it and the reader carries the partial state; a chunk
// that completes three documents produces three.  An empty chunk is
// legal and completes nothing — it is not an end-of-stream signal,
// because a caller reading a socket gets empty reads for reasons that
// are not the end.  `finish` is the end-of-stream signal.
//
// A failure does not throw away the documents already completed in
// this chunk: they are returned, the reader is left failed, and
// `error` says why.  A caller streaming a large manifest therefore
// keeps everything up to the corruption, which is what a person
// fixing the file wants to see.
//
// ```novo
// use yamlread
// use yamlsafe
//
// fn main() [io]
//     let r = yamlread.reader(yamlsafe.standard())
//     let (_, docs) = yamlread.feed(r, bytes.from_str("a: 1\n---\nb: 2\n"))
//     println("${list.len(docs)}")              // 1 — the second is unterminated
// ```
pub fn feed(r: YamlReader, chunk: Bytes) -> (YamlReader, [YamlValue])
    var m = machine(r)
    feed_bytes(m, bytes.to_byte_list(chunk))
    probe(m)
    (reader_of(m), m.docs[:])

// `feed` for a caller who has a `Str`.
//
// The same machine — the string is read as its bytes — and it exists
// because a caller who has already read a file into a string should
// not have to convert it back to bytes to hand it over.
//
// ```novo
// use yamlread
// use yamlsafe
//
// fn main() [io]
//     let r = yamlread.reader(yamlsafe.standard())
//     let (_, docs) = yamlread.feed_str(r, "a: 1\n...\n")
//     println("${list.len(docs)}")              // 1
// ```
pub fn feed_str(r: YamlReader, chunk: Str) -> (YamlReader, [YamlValue])
    var m = machine(r)
    feed_text(m, chunk)
    probe(m)
    (reader_of(m), m.docs[:])

// End of stream: the last document, if it was not terminated, and the
// verdict.
//
// A YAML stream's final document need not carry a terminator, so a
// stream ending `b: 2` has a document in it that no `feed` has
// emitted — this is where it comes out.  A stream that ended with a
// terminator has nothing left and this returns an empty list, not a
// document containing null.
//
// `Err` when the reader is failed, including the failure a `feed`
// recorded earlier and the one only the end of the stream can find: a
// flow collection or a quoted scalar that was never closed.
//
// ```novo
// use yamlread
// use yamlsafe
//
// fn main() [io]
//     let r = yamlread.reader(yamlsafe.standard())
//     let (r2, _) = yamlread.feed_str(r, "a: 1\n")
//     match yamlread.finish(r2)
//         Ok(docs) => println("${list.len(docs)}")   // 1
//         Err(e)   => println(e.message())
// ```
pub fn finish(r: YamlReader) -> Result<[YamlValue], YamlError>
    var m = machine(r)
    end_of_stream(m)
    if let Some(e) = m.failure
        return Err(e)
    Ok(m.docs[:])

// The sticky failure this reader is carrying, or `None`.
//
// Once set it is never cleared.  A YAML stream that has gone wrong at
// line 4,000 does not come right at the next `---`: the indentation
// state the parser would need to resynchronise is exactly the state
// that is wrong, and a reader that guessed would emit documents that
// are not in the file.
//
// ```novo
// use yamlread
// use yamlsafe
//
// fn main() [io]
//     let r = yamlread.reader(yamlsafe.standard())
//     match yamlread.error(r)
//         Some(_) => println("failed")
//         None    => println("fine")
// ```
pub fn error(r: YamlReader) -> ?YamlError
    r.failure

// Parse a single-document string.
//
// The common case, and the one every caller reaching for this package
// has: one file, one document, a tree or a reason.  A stream with a
// second document is `BadDirective` at the `---` rather than silently
// keeping the first — a caller that wrote `parse` and got a
// multi-document file has a decision to make, and picking one for
// them is how a deployment applies half a manifest.
//
// ```novo
// use yamlread
// use yamlsafe
// use yamlkeys
//
// fn main() [io]
//     match yamlread.parse("db:\n  port: 5432\n", yamlsafe.standard())
//         Ok(doc) => println("${yamlkeys.int_at(doc, "db.port")!}")
//         Err(e)  => println(e.message())
// ```
pub fn parse(text: Str, p: YamlLimits) -> Result<YamlValue, YamlError>
    var m = machine(reader(p))
    feed_text(m, text)
    end_of_stream(m)
    if let Some(e) = m.failure
        return Err(e)
    if list.len(m.docs) > 1
        return Err(BadDirective(m.starts[1], 1, "---"))
    if list.len(m.docs) == 0
        return Ok(YamlNull)
    Ok(m.docs[0])

// Parse a multi-document stream, in order.
//
// An empty stream is an empty list rather than an error, and a stream
// of one document is a list of one — so a caller that does not know
// which it has can always use this and count.
//
// ```novo
// use yamlread
// use yamlsafe
//
// fn main() [io]
//     match yamlread.parse_stream("a: 1\n---\nb: 2\n", yamlsafe.standard())
//         Ok(docs) => println("${list.len(docs)}")   // 2
//         Err(e)   => println(e.message())
// ```
pub fn parse_stream(text: Str, p: YamlLimits) -> Result<[YamlValue], YamlError>
    var m = machine(reader(p))
    feed_text(m, text)
    end_of_stream(m)
    if let Some(e) = m.failure
        return Err(e)
    Ok(m.docs[:])

// Parse the bytes of a stream.
//
// The same parser: YAML is UTF-8 by specification, and this checks
// that rather than assuming it — a `Bytes` that is not valid UTF-8 is
// `UnexpectedByte` at the offending byte, with a position.
//
// ```novo
// use yamlread
// use yamlsafe
//
// fn main() [io]
//     match yamlread.parse_bytes(bytes.from_str("a: 1\n"), yamlsafe.standard())
//         Ok(_)  => println("ok")
//         Err(_) => println("not yaml")
// ```
pub fn parse_bytes(input: Bytes, p: YamlLimits) -> Result<[YamlValue], YamlError>
    var m = machine(reader(p))
    feed_bytes(m, bytes.to_byte_list(input))
    end_of_stream(m)
    if let Some(e) = m.failure
        return Err(e)
    Ok(m.docs[:])

// Read a whole stream and parse the documents it held, charged exactly
// what the stream costs.
//
// `S: Read[e]` binds the
// effect parameter of `Read` and the clause is `[e]`, so this package
// is charged nothing and the caller is charged what its own impl
// declared (SPEC § 5.6, and `docs/publishing.md` § Design).  A `File`
// costs the caller `[io, fs]`; an in-memory `Buffer` costs nothing;
// `yaml-nv` remains `core` either way.
//
// The stream's own failure is carried through as `Transport`, so a
// caller can still tell a truncated read from a malformed document.
//
// ```novo
// use yamlread
// use yamlsafe
//
// fn load(path: Str) -> Result<[YamlValue], YamlError> [io, fs]
//     match File.open_read(path)
//         None    => Err(Transport(IoNotFound))
//         Some(f) =>
//             let h: File = f
//             yamlread.read_all(h, yamlsafe.standard())
//
// fn main() [io, fs]
//     match load("deploy.yaml")
//         Ok(docs) => println("${list.len(docs)} document(s)")
//         Err(e)   => println(yamlerror.render(e, "deploy.yaml"))
// ```
pub fn read_all<S: Read[e]>(src: S, p: YamlLimits) -> Result<[YamlValue], YamlError> [e]
    var m = machine(reader(p))
    loop
        match src.read(65536)
            Err(e)    =>
                return Err(Transport(e))
            Ok(chunk) =>
                if bytes.len(chunk) == 0
                    break
                feed_bytes(m, bytes.to_byte_list(chunk))
    end_of_stream(m)
    if let Some(e) = m.failure
        return Err(e)
    Ok(m.docs[:])

// The first refusal a parse would produce, for a caller that wants to
// check a stream without keeping the trees.
//
// `None` when it parses.  It is `parse_stream` with the `Ok` arm
// dropped, and it exists because a linter, a pre-commit hook, an
// admission controller and an editor's save handler all ask exactly
// this question and none of them wants the allocation.
//
// ```novo
// use yamlread
// use yamlsafe
//
// fn main() [io]
//     match yamlread.check("a:\n\tb: 1\n", yamlsafe.standard())
//         Some(e) => println(e.message())       // a tab where a space is required
//         None    => println("valid")
// ```
pub fn check(text: Str, p: YamlLimits) -> ?YamlError
    match parse_stream(text, p)
        Ok(_)  => None
        Err(e) => Some(e)

// The anchors a document defined, in the order they were defined.
//
// Names only — the nodes are already in the tree the alias expanded
// into.  It is here because a tool that REWRITES YAML has to know
// which names are taken before it invents one, and because a document
// whose anchors are all unused is a document a person can simplify,
// which is a lint worth being able to write.
//
// ```novo
// use yamlread
// use yamlsafe
//
// fn main() [io]
//     let r = yamlread.reader(yamlsafe.standard())
//     let (r2, _) = yamlread.feed_str(r, "a: &base 1\nb: *base\n")
//     println("${list.len(yamlread.anchors_of(r2))}")
// ```
pub fn anchors_of(r: YamlReader) -> [Str]
    r.anchors[:]

// ── The machine ───────────────────────────────────────────────────────

// A reader's state while a call works on it, and the documents the call
// completed.
struct Machine
    limits: YamlLimits
    var line: Int
    var doc_index: Int
    var partial: Str
    var pending: [Int]
    var in_doc: Bool
    var doc_lines: [Str]
    var doc_line: Int
    var marked: Bool
    var directives: [Str]
    var anchors: [Str]
    var failure: ?YamlError
    var docs: [YamlValue]
    // The stream line each completed document started on.
    var starts: [Int]

fn machine(r: YamlReader) -> Machine
    Machine { limits: r.limits, line: r.line, doc_index: r.doc_index, partial: r.partial,
              pending: r.pending[:], in_doc: r.in_doc, doc_lines: r.doc_lines[:],
              doc_line: r.doc_line, marked: r.marked, directives: r.directives[:],
              anchors: r.anchors[:], failure: r.failure, docs: [], starts: [] }

fn reader_of(m: Machine) -> YamlReader
    YamlReader { limits: m.limits, line: m.line, doc_index: m.doc_index, partial: m.partial,
                 pending: m.pending[:], in_doc: m.in_doc, doc_lines: m.doc_lines[:],
                 doc_line: m.doc_line, marked: m.marked, directives: m.directives[:],
                 anchors: m.anchors[:], failure: m.failure }

// Read bytes: the complete UTF-8 sequences now, and the tail of one the
// chunk ended inside with the next chunk.
// Read the open document so far, and keep a refusal that no later line
// could undo.  An unclosed quote or bracket may still be closed by the
// next chunk; every other refusal is about lines that are complete.
fn probe(var m: Machine)
    if not m.in_doc or m.failure != None
        return
    let text = str.join(m.doc_lines, "\n") + "\n"
    var names: [Str] = []
    match yamlparse.parse_doc(text, m.doc_line, handles(m), m.limits, m.marked, names)
        Ok(_)  =>
            pass
        Err(e) =>
            match e
                UnterminatedQuote(_, _) =>
                    pass
                UnterminatedFlow(_, _)  =>
                    pass
                _                       =>
                    m.failure = Some(e)

fn feed_bytes(var m: Machine, chunk: [u8])
    if m.failure != None
        return
    var all = list.concat(m.pending, chunk)
    let n = list.len(all)
    let keep = incomplete_tail(all)
    let body = all[0:n - keep]
    m.pending = all[n - keep:n]
    let bad = utf8_fault(body)
    if bad >= 0
        m.failure = Some(byte_fault(m, body, bad))
        return
    feed_text(m, bytes.to_str(bytes.from_byte_list(body)))

// How many bytes at the end of `bs` begin a UTF-8 sequence that is not
// complete yet.
fn incomplete_tail(bs: [u8]) -> Int
    let n = list.len(bs)
    for back in 1..4
        if back > n
            break
        let b = bs[n - back]
        if b < 0x80
            return 0
        if b >= 0xC0
            let need = if b >= 0xF0
                4
            else if b >= 0xE0
                3
            else
                2
            return if need > back then back else 0
    0

// The index of the first byte of `bs` that is not valid UTF-8, or a zero
// byte, or -1.
fn utf8_fault(bs: [u8]) -> Int
    let n = list.len(bs)
    var i = 0
    for _ in 0..n + 1
        if i >= n
            break
        let b = bs[i]
        if b == 0
            return i
        if b < 0x80
            i = i + 1
            continue
        let need = sequence_length(b)
        if need == 0 or i + need > n
            return i
        for k in 1..need
            if bs[i + k] < 0x80 or bs[i + k] >= 0xC0
                return i
        i = i + need
    -1

// The length of the UTF-8 sequence a lead byte starts, or 0 for a byte
// that starts none.
fn sequence_length(b: Int) -> Int
    if b >= 0xC2 and b < 0xE0
        2
    elif b >= 0xE0 and b < 0xF0
        3
    elif b >= 0xF0 and b < 0xF5
        4
    else
        0

// `UnexpectedByte` for the byte at `at` of `body`, positioned in the
// stream.
fn byte_fault(m: Machine, body: [u8], at: Int) -> YamlError
    var line = m.line
    var col = str.len(m.partial) + 1
    for i in 0..at
        if body[i] == '\n'
            line = line + 1
            col = 1
        else
            col = col + 1
    UnexpectedByte(line, col, body[at])

// Read text: every line it completes, and the rest kept for later.
fn feed_text(var m: Machine, text: Str)
    if m.failure != None
        return
    let data = m.partial + text
    let n = str.len(data)
    var start = 0
    for i in 0..n
        if str.byte_at_or(data, i, 0) == '\n'
            var e = i
            if e > start and str.byte_at_or(data, e - 1, 0) == '\r'
                e = e - 1
            take_line(m, str.slice(data, start, e))
            start = i + 1
            if m.failure != None
                break
    m.partial = str.slice(data, start, n)

fn end_of_stream(var m: Machine)
    if m.failure != None
        return
    if list.len(m.pending) > 0
        m.failure = Some(byte_fault(m, m.pending, 0))
        return
    if m.partial != ""
        let last = m.partial
        m.partial = ""
        take_line(m, last)
    if m.in_doc and m.failure == None
        emit(m)
    elif not m.in_doc and m.failure == None and list.len(m.directives) > 0
        // A directive belongs to the document after it, and there is
        // none (section 9.2).
        m.failure = Some(BadDirective(m.line - 1, 1, m.directives[0]))

// Whether `line` is the document marker `mark` (section 9.1.4): at the
// start of the line and followed by whitespace or nothing.
fn marker(line: Str, mark: Str) -> Bool
    let after = str.byte_at_or(line, 3, 32)
    str.starts_with(line, mark) and (after == ' ' or after == '\t')

fn blank_or_comment(line: Str) -> Bool
    let t = str.trim(line)
    t == "" or str.starts_with(t, "#")

// One complete line of the stream.
fn take_line(var m: Machine, line: Str)
    if marker(line, "---")
        if m.in_doc
            emit(m)
        if m.failure == None
            m.in_doc = true
            m.marked = true
            m.doc_line = m.line
            m.doc_lines = ["   " + str.slice(line, 3, str.len(line))]
    elif marker(line, "...")
        if m.in_doc
            emit(m)
        elif list.len(m.directives) > 0
            m.failure = Some(BadDirective(m.line, 1, m.directives[0]))
        let rest = str.slice(line, 3, str.len(line))
        if m.failure == None and not blank_or_comment(rest)
            let t = str.trim_start(rest)
            m.failure = Some(UnexpectedByte(m.line, str.len(line) - str.len(t) + 1,
                                            str.byte_at_or(t, 0, 0)))
        m.directives = []
    elif m.in_doc
        list.push(m.doc_lines, line)
    elif str.starts_with(line, "%")
        directive(m, line)
    elif not blank_or_comment(line)
        if list.len(m.directives) > 0
            m.failure = Some(BadDirective(m.line, 1, m.directives[0]))
        else
            m.in_doc = true
            m.marked = false
            m.doc_line = m.line
            m.doc_lines = [line]
    m.line = m.line + 1

// A `%YAML` or `%TAG` directive (section 6.8), kept for the next
// document.  A `%YAML` for a version other than 1.x, a second one, and
// a malformed `%TAG` are refused; any other directive is reserved and
// ignored, as section 6.8.1 says.
fn directive(var m: Machine, line: Str)
    let words = str.words(line)
    let name = words[0]
    var ok = true
    let count = significant_words(words)
    if name == "%YAML"
        ok = count == 2 and version_ok(words[1]) and not has_yaml_directive(m)
    elif name == "%TAG"
        ok = count == 3 and str.starts_with(words[1], "!") and str.ends_with(words[1], "!")
    if not ok
        m.failure = Some(BadDirective(m.line, 1, line))
        return
    list.push(m.directives, line)

// How many words a directive has before a comment.
fn significant_words(words: [Str]) -> Int
    var n = 0
    for w in words
        if str.starts_with(w, "#")
            break
        n = n + 1
    n

// A `%YAML` version this reader reads: 1, a period, and digits.
fn version_ok(v: Str) -> Bool
    if not str.starts_with(v, "1.") or str.len(v) < 3
        return false
    for i in 2..str.len(v)
        let b = str.byte_at_or(v, i, 0)
        if b < '0' or b > '9'
            return false
    true

fn has_yaml_directive(m: Machine) -> Bool
    for d in m.directives
        if str.starts_with(d, "%YAML")
            return true
    false

// The `%TAG` handles the pending directives declare.
fn handles(m: Machine) -> HashMap<Str, Str>
    var out: HashMap<Str, Str> = HashMap.new()
    for d in m.directives
        let words = str.words(d)
        if words[0] == "%TAG"
            out.set(words[1], words[2])
    out

// Parse the open document and add it to the completed ones.
fn emit(var m: Machine)
    let text = str.join(m.doc_lines, "\n") + "\n"
    var names: [Str] = []
    match yamlparse.parse_doc(text, m.doc_line, handles(m), m.limits, m.marked, names)
        Ok(v)  =>
            list.push(m.docs, v)
            list.push(m.starts, m.doc_line)
            m.anchors = names
            m.doc_index = m.doc_index + 1
        Err(e) =>
            m.failure = Some(e)
    m.in_doc = false
    m.doc_lines = []
    m.directives = []
