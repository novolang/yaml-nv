// yts_tests.nv — the yaml-test-suite corpus, every case this package
// reads as the suite says.
//
// Written by tools/yaml_test_suite.py from the suite's data branch
// (https://github.com/yaml/yaml-test-suite); do not edit by hand.  A
// valid case asserts the documents as JSON, which the generator
// compared with the suite's own `in.json`; an invalid case asserts a
// refusal.  Every valid case also goes through the writer and back.
// The two cases left out bind one key twice, which this package
// refuses and the suite does not.

use std.test
use yamlnode
use yamlread
use yamlsafe
use yamlwrite

fn policy(tags: [Str]) -> YamlLimits
    yamlsafe.with_complex_keys(yamlsafe.allowing(yamlsafe.standard(), tags), true)

fn json_str(s: Str) -> Str
    var parts: [Str] = ["\""]
    for i in 0..str.len(s)
        let b = str.byte_at_or(s, i, 0)
        if b == '"'
            list.push(parts, "\\\"")
        elif b == '\\'
            list.push(parts, "\\\\")
        elif b == '\n'
            list.push(parts, "\\n")
        elif b == '\t'
            list.push(parts, "\\t")
        elif b == '\r'
            list.push(parts, "\\r")
        elif b < 32
            let hex = str.slice("0123456789abcdef", b % 16, b % 16 + 1)
            list.push(parts, (if b < 16 then "\\u000" else "\\u001") + hex)
        else
            list.push(parts, str.from_byte(b))
    list.push(parts, "\"")
    str.join(parts, "")

fn key_json(k: YamlValue) -> Str
    match k
        YamlStr(s) => json_str(s)
        YamlNull   => json_str("")
        _          => json_str(yamlwrite.scalar_to_string(k))

fn to_json(v: YamlValue) -> Str
    match v
        YamlMap(pairs) =>
            var parts: [Str] = []
            for p in pairs
                list.push(parts, key_json(p.key) + ":" + to_json(p.value))
            "{" + str.join(parts, ",") + "}"
        YamlSeq(items) =>
            var parts: [Str] = []
            for x in items
                list.push(parts, to_json(x))
            "[" + str.join(parts, ",") + "]"
        YamlStr(s)     => json_str(s)
        YamlInt(i)     => "${i}"
        YamlFloat(f)   => float_json(v, f)
        YamlBool(b)    => str.from_bool(b)
        YamlNull       => "null"

fn float_json(v: YamlValue, f: Float) -> Str
    if f != f or f > 1.0e308 or f < -1.0e308
        return json_str(yamlwrite.scalar_to_string(v))
    str.from_float_shortest(f)

// The documents of a valid case, as JSON, and whether the writer's
// output of each reads back equal.
fn read_as(text: Str, tags: [Str]) -> Str
    match yamlread.parse_stream(text, policy(tags))
        Err(e)   => "error: " + e.message()
        Ok(docs) =>
            var parts: [Str] = []
            for d in docs
                list.push(parts, to_json(d))
                if not round_trips(d, tags)
                    return "does not round-trip: " + to_json(d)
            "[" + str.join(parts, ",") + "]"

fn round_trips(d: YamlValue, tags: [Str]) -> Bool
    if yamlwrite.check(d) != None
        return true
    match yamlwrite.to_string(d, yamlwrite.standard())
        Err(_)  => false
        Ok(out) =>
            match yamlread.parse(out, policy(tags))
                Ok(back) => yamlnode.equal(back, d)
                Err(_)   => false

fn refused(text: Str, tags: [Str]) -> Bool
    match yamlread.parse_stream(text, policy(tags))
        Ok(_)  => false
        Err(_) => true

@test
fn test_cases_001() [io]
    test.case("229Q")
    test.assert(read_as("-\n  name: Mark McGwire\n  hr:   65\n  avg:  0.278\n-\n  name: Sammy Sosa\n  hr:   63\n  avg:  0.288\n",
        [])
                == "[[{\"name\":\"Mark McGwire\",\"hr\":65,\"avg\":0.278},{\"name\":\"Sammy Sosa\",\"hr\":63,\"avg\":0.288}]]")
    test.case("236B")
    test.assert(refused("foo:\n  bar\ninvalid\n", []))
    test.case("26DV")
    test.assert(read_as("\"top1\" : \n  \"key1\" : &alias1 scalar1\n'top2' : \n  'key2' : &alias2 scalar2\ntop3: &node3 \n  *alias1 : scalar3\ntop4: \n  *alias2 : scalar4\ntop5   :    \n  scalar5\ntop6: \n  &anchor6 'key6' : scalar6\n",
        [])
                == "[{\"top1\":{\"key1\":\"scalar1\"},\"top2\":{\"key2\":\"scalar2\"},\"top3\":{\"scalar1\":\"scalar3\"},\"top4\":{\"scalar2\":\"scalar4\"},\"top5\":\"scalar5\",\"top6\":{\"key6\":\"scalar6\"}}]")
    test.case("27NA")
    test.assert(read_as("%YAML 1.2\n--- text\n", [])
                == "[\"text\"]")
    test.case("2AUY")
    test.assert(read_as(" - !!str a\n - b\n - !!int 42\n - d\n", ["!!int", "!!str"])
                == "[[\"a\",\"b\",42,\"d\"]]")
    test.case("2CMS")
    test.assert(refused("this\n is\n  invalid: x\n", []))
    test.case("2EBW")
    test.assert(read_as("a!\"#\$%&'()*+,-./09:;<=>?@AZ[\\]^_`az{|}~: safe\n?foo: safe question mark\n:foo: safe colon\n-foo: safe dash\nthis is#not: a comment\n",
        [])
                == "[{\"a!\\\"#\$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az{|}~\":\"safe\",\"?foo\":\"safe question mark\",\":foo\":\"safe colon\",\"-foo\":\"safe dash\",\"this is#not\":\"a comment\"}]")
    test.case("2G84/00")
    test.assert(refused("--- |0\n", []))
    test.case("2G84/01")
    test.assert(refused("--- |10\n", []))
    test.case("2G84/02")
    test.assert(read_as("--- |1-", [])
                == "[\"\"]")
    test.case("2G84/03")
    test.assert(read_as("--- |1+", [])
                == "[\"\"]")
    test.case("2LFX")
    test.assert(read_as("%FOO  bar baz # Should be ignored\n              # with a warning.\n---\n\"foo\"\n", [])
                == "[\"foo\"]")
    test.case("2SXE")
    test.assert(read_as("&a: key: &a value\nfoo:\n  *a:\n", [])
                == "[{\"key\":\"value\",\"foo\":\"key\"}]")
    test.case("2XXW")
    test.assert(read_as("# Sets are represented as a\n# Mapping where each key is\n# associated with a null value\n--- !!set\n? Mark McGwire\n? Sammy Sosa\n? Ken Griff\n",
        ["!!set"])
                == "[{\"Mark McGwire\":null,\"Sammy Sosa\":null,\"Ken Griff\":null}]")
    test.case("33X3")
    test.assert(read_as("---\n- !!int 1\n- !!int -2\n- !!int 33\n", ["!!int"])
                == "[[1,-2,33]]")
    test.case("35KP")
    test.assert(read_as("--- !!map\n? a\n: b\n--- !!seq\n- !!str c\n--- !!str\nd\ne\n", ["!!map", "!!seq", "!!str"])
                == "[{\"a\":\"b\"},[\"c\"],\"d e\"]")
    test.case("36F6")
    test.assert(read_as("---\nplain: a\n b\n\n c\n", [])
                == "[{\"plain\":\"a b\\nc\"}]")
    test.case("3ALJ")
    test.assert(read_as("- - s1_i1\n  - s1_i2\n- s2\n", [])
                == "[[[\"s1_i1\",\"s1_i2\"],\"s2\"]]")
    test.case("3GZX")
    test.assert(read_as("First occurrence: &anchor Foo\nSecond occurrence: *anchor\nOverride anchor: &anchor Bar\nReuse anchor: *anchor\n",
        [])
                == "[{\"First occurrence\":\"Foo\",\"Second occurrence\":\"Foo\",\"Override anchor\":\"Bar\",\"Reuse anchor\":\"Bar\"}]")
    test.case("3HFZ")
    test.assert(refused("---\nkey: value\n... invalid\n", []))
    test.case("3MYT")
    test.assert(read_as("---\nk:#foo\n &a !t s\n", ["!t"])
                == "[\"k:#foo &a !t s\"]")
    test.case("3R3P")
    test.assert(read_as("&sequence\n- a\n", [])
                == "[[\"a\"]]")
    test.case("3RLN/00")
    test.assert(read_as("\"1 leading\n    \\ttab\"\n", [])
                == "[\"1 leading \\ttab\"]")
    test.case("3RLN/01")
    test.assert(read_as("\"2 leading\n    \\\ttab\"\n", [])
                == "[\"2 leading \\ttab\"]")
    test.case("3RLN/02")
    test.assert(read_as("\"3 leading\n    \ttab\"\n", [])
                == "[\"3 leading tab\"]")
    test.case("3RLN/03")
    test.assert(read_as("\"4 leading\n    \\t  tab\"\n", [])
                == "[\"4 leading \\t  tab\"]")
    test.case("3RLN/04")
    test.assert(read_as("\"5 leading\n    \\\t  tab\"\n", [])
                == "[\"5 leading \\t  tab\"]")
    test.case("3RLN/05")
    test.assert(read_as("\"6 leading\n    \t  tab\"\n", [])
                == "[\"6 leading tab\"]")
    test.case("3UYS")
    test.assert(read_as("escaped slash: \"a\\/b\"\n", [])
                == "[{\"escaped slash\":\"a/b\"}]")
    test.case("4CQQ")
    test.assert(read_as("plain:\n  This unquoted scalar\n  spans many lines.\n\nquoted: \"So does this\n  quoted scalar.\\n\"\n",
        [])
                == "[{\"plain\":\"This unquoted scalar spans many lines.\",\"quoted\":\"So does this quoted scalar.\\n\"}]")
    test.case("4EJS")
    test.assert(refused("---\na:\n\tb:\n\t\tc: value\n", []))
    test.case("4GC6")
    test.assert(read_as("'here''s to \"quotes\"'\n", [])
                == "[\"here's to \\\"quotes\\\"\"]")
    test.case("4H7K")
    test.assert(refused("---\n[ a, b, c ] ]\n", []))
    test.case("4HVU")
    test.assert(refused("key:\n   - ok\n   - also ok\n  - wrong\n", []))
    test.case("4JVG")
    test.assert(refused("top1: &node1\n  &k1 key1: val1\ntop2: &node2\n  &v2 val2\n", []))
    test.case("4MUZ/00")
    test.assert(read_as("{\"foo\"\n: \"bar\"}\n", [])
                == "[{\"foo\":\"bar\"}]")
    test.case("4MUZ/01")
    test.assert(read_as("{\"foo\"\n: bar}\n", [])
                == "[{\"foo\":\"bar\"}]")
    test.case("4MUZ/02")
    test.assert(read_as("{foo\n: bar}\n", [])
                == "[{\"foo\":\"bar\"}]")
    test.case("4Q9F")
    test.assert(read_as("--- >\n ab\n cd\n \n ef\n\n\n gh\n", [])
                == "[\"ab cd\\nef\\n\\ngh\\n\"]")
    test.case("4QFQ")
    test.assert(read_as("- |\n detected\n- >\n \n  \n  # detected\n- |1\n  explicit\n- >\n detected\n", [])
                == "[[\"detected\\n\",\"\\n\\n# detected\\n\",\" explicit\\n\",\"detected\\n\"]]")

@test
fn test_cases_002() [io]
    test.case("4RWC")
    test.assert(read_as("  [1, 2, 3]  \n  ", [])
                == "[[1,2,3]]")
    test.case("4UYU")
    test.assert(read_as("\"foo: bar\\\": baz\"\n", [])
                == "[\"foo: bar\\\": baz\"]")
    test.case("4V8U")
    test.assert(read_as("---\nplain\\value\\with\\backslashes\n", [])
                == "[\"plain\\\\value\\\\with\\\\backslashes\"]")
    test.case("4WA9")
    test.assert(read_as("- aaa: |2\n    xxx\n  bbb: |\n    xxx\n", [])
                == "[[{\"aaa\":\"xxx\\n\",\"bbb\":\"xxx\\n\"}]]")
    test.case("4ZYM")
    test.assert(read_as("plain: text\n  lines\nquoted: \"text\n  \tlines\"\nblock: |\n  text\n   \tlines\n", [])
                == "[{\"plain\":\"text lines\",\"quoted\":\"text lines\",\"block\":\"text\\n \\tlines\\n\"}]")
    test.case("52DL")
    test.assert(read_as("---\n! a\n", ["!"])
                == "[\"a\"]")
    test.case("54T7")
    test.assert(read_as("{foo: you, bar: far}\n", [])
                == "[{\"foo\":\"you\",\"bar\":\"far\"}]")
    test.case("55WF")
    test.assert(refused("---\n\"\\.\"\n", []))
    test.case("565N")
    test.assert(read_as("canonical: !!binary \"\\\n R0lGODlhDAAMAIQAAP//9/X17unp5WZmZgAAAOfn515eXvPz7Y6OjuDg4J+fn5\\\n OTk6enp56enmlpaWNjY6Ojo4SEhP/++f/++f/++f/++f/++f/++f/++f/++f/+\\\n +f/++f/++f/++f/++f/++SH+Dk1hZGUgd2l0aCBHSU1QACwAAAAADAAMAAAFLC\\\n AgjoEwnuNAFOhpEMTRiggcz4BNJHrv/zCFcLiwMWYNG84BwwEeECcgggoBADs=\"\ngeneric: !!binary |\n R0lGODlhDAAMAIQAAP//9/X17unp5WZmZgAAAOfn515eXvPz7Y6OjuDg4J+fn5\n OTk6enp56enmlpaWNjY6Ojo4SEhP/++f/++f/++f/++f/++f/++f/++f/++f/+\n +f/++f/++f/++f/++f/++SH+Dk1hZGUgd2l0aCBHSU1QACwAAAAADAAMAAAFLC\n AgjoEwnuNAFOhpEMTRiggcz4BNJHrv/zCFcLiwMWYNG84BwwEeECcgggoBADs=\ndescription:\n The binary value above is a tiny arrow encoded as a gif image.\n",
        ["!!binary"])
                == "[{\"canonical\":\"R0lGODlhDAAMAIQAAP//9/X17unp5WZmZgAAAOfn515eXvPz7Y6OjuDg4J+fn5OTk6enp56enmlpaWNjY6Ojo4SEhP/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++SH+Dk1hZGUgd2l0aCBHSU1QACwAAAAADAAMAAAFLCAgjoEwnuNAFOhpEMTRiggcz4BNJHrv/zCFcLiwMWYNG84BwwEeECcgggoBADs=\",\"generic\":\"R0lGODlhDAAMAIQAAP//9/X17unp5WZmZgAAAOfn515eXvPz7Y6OjuDg4J+fn5\\nOTk6enp56enmlpaWNjY6Ojo4SEhP/++f/++f/++f/++f/++f/++f/++f/++f/+\\n+f/++f/++f/++f/++f/++SH+Dk1hZGUgd2l0aCBHSU1QACwAAAAADAAMAAAFLC\\nAgjoEwnuNAFOhpEMTRiggcz4BNJHrv/zCFcLiwMWYNG84BwwEeECcgggoBADs=\\n\",\"description\":\"The binary value above is a tiny arrow encoded as a gif image.\"}]")
    test.case("57H4")
    test.assert(read_as("sequence: !!seq\n- entry\n- !!seq\n - nested\nmapping: !!map\n foo: bar\n",
        ["!!map", "!!seq"])
                == "[{\"sequence\":[\"entry\",[\"nested\"]],\"mapping\":{\"foo\":\"bar\"}}]")
    test.case("58MP")
    test.assert(read_as("{x: :x}\n", [])
                == "[{\"x\":\":x\"}]")
    test.case("5BVJ")
    test.assert(read_as("literal: |\n  some\n  text\nfolded: >\n  some\n  text\n", [])
                == "[{\"literal\":\"some\\ntext\\n\",\"folded\":\"some text\\n\"}]")
    test.case("5C5M")
    test.assert(read_as("- { one : two , three: four , }\n- {five: six,seven : eight}\n", [])
                == "[[{\"one\":\"two\",\"three\":\"four\"},{\"five\":\"six\",\"seven\":\"eight\"}]]")
    test.case("5GBF")
    test.assert(read_as("Folding:\n  \"Empty line\n   \t\n  as a line feed\"\nChomping: |\n  Clipped empty lines\n \n\n",
        [])
                == "[{\"Folding\":\"Empty line\\nas a line feed\",\"Chomping\":\"Clipped empty lines\\n\"}]")
    test.case("5KJE")
    test.assert(read_as("- [ one, two, ]\n- [three ,four]\n", [])
                == "[[[\"one\",\"two\"],[\"three\",\"four\"]]]")
    test.case("5LLU")
    test.assert(refused("block scalar: >\n \n  \n   \n invalid\n", []))
    test.case("5MUD")
    test.assert(read_as("---\n{ \"foo\"\n  :bar }\n", [])
                == "[{\"foo\":\"bar\"}]")
    test.case("5NYZ")
    test.assert(read_as("key:    # Comment\n  value\n", [])
                == "[{\"key\":\"value\"}]")
    test.case("5T43")
    test.assert(read_as("- { \"key\":value }\n- { \"key\"::value }\n", [])
                == "[[{\"key\":\"value\"},{\"key\":\":value\"}]]")
    test.case("5TRB")
    test.assert(refused("---\n\"\n---\n\"\n", []))
    test.case("5TYM")
    test.assert(read_as("%TAG !m! !my-\n--- # Bulb here\n!m!light fluorescent\n...\n%TAG !m! !my-\n--- # Color here\n!m!light green\n",
        ["!m!", "!m!light", "!my-"])
                == "[\"fluorescent\",\"green\"]")
    test.case("5U3A")
    test.assert(refused("key: - a\n     - b\n", []))
    test.case("5WE3")
    test.assert(read_as("? explicit key # Empty value\n? |\n  block key\n: - one # Explicit compact\n  - two # block value\n",
        [])
                == "[{\"explicit key\":null,\"block key\\n\":[\"one\",\"two\"]}]")
    test.case("62EZ")
    test.assert(refused("---\nx: { y: z }in: valid\n", []))
    test.case("652Z")
    test.assert(read_as("{ ?foo: bar,\nbar: 42\n}\n", [])
                == "[{\"?foo\":\"bar\",\"bar\":42}]")
    test.case("65WH")
    test.assert(read_as("- foo\n", [])
                == "[[\"foo\"]]")
    test.case("6BCT")
    test.assert(read_as("- foo:\t bar\n- - baz\n  -\tbaz\n", [])
                == "[[{\"foo\":\"bar\"},[\"baz\",\"baz\"]]]")
    test.case("6CA3")
    test.assert(read_as("\t[\n\t]\n", [])
                == "[[]]")
    test.case("6CK3")
    test.assert(read_as("%TAG !e! tag:example.com,2000:app/\n---\n- !local foo\n- !!str bar\n- !e!tag%21 baz\n",
        ["!!str", "!e!", "!e!tag%21", "!local"])
                == "[[\"foo\",\"bar\",\"baz\"]]")
    test.case("6FWR")
    test.assert(read_as("--- |+\n ab\n \n  \n...\n", [])
                == "[\"ab\\n\\n \\n\"]")
    test.case("6H3V")
    test.assert(read_as("'foo: bar\\': baz'\n", [])
                == "[{\"foo: bar\\\\\":\"baz'\"}]")
    test.case("6HB6")
    test.assert(read_as("  # Leading comment line spaces are\n   # neither content nor indentation.\n    \nNot indented:\n By one space: |\n    By four\n      spaces\n Flow style: [    # Leading spaces\n   By two,        # in flow style\n  Also by two,    # are neither\n  \tStill by two   # content nor\n    ]             # indentation.\n",
        [])
                == "[{\"Not indented\":{\"By one space\":\"By four\\n  spaces\\n\",\"Flow style\":[\"By two\",\"Also by two\",\"Still by two\"]}}]")
    test.case("6JQW")
    test.assert(read_as("# ASCII Art\n--- |\n  \\//||\\/||\n  // ||  ||__\n", [])
                == "[\"\\\\//||\\\\/||\\n// ||  ||__\\n\"]")
    test.case("6JTT")
    test.assert(refused("---\n[ [ a, b, c ]\n", []))
    test.case("6JWB")
    test.assert(read_as("foo: !!seq\n  - !!str a\n  - !!map\n    key: !!str value\n", ["!!map", "!!seq", "!!str"])
                == "[{\"foo\":[\"a\",{\"key\":\"value\"}]}]")
    test.case("6KGN")
    test.assert(read_as("---\na: &anchor\nb: *anchor\n", [])
                == "[{\"a\":null,\"b\":null}]")
    test.case("6LVF")
    test.assert(read_as("%FOO  bar baz # Should be ignored\n              # with a warning.\n--- \"foo\"\n", [])
                == "[\"foo\"]")
    test.case("6S55")
    test.assert(refused("key:\n - bar\n - baz\n invalid\n", []))
    test.case("6SLA")
    test.assert(read_as("\"foo\\nbar:baz\\tx \\\\\$%^&*()x\": 23\n'x\\ny:z\\tx \$%^&*()x': 24\n", [])
                == "[{\"foo\\nbar:baz\\tx \\\\\$%^&*()x\":23,\"x\\\\ny:z\\\\tx \$%^&*()x\":24}]")
    test.case("6VJK")
    test.assert(read_as(">\n Sammy Sosa completed another\n fine season with great stats.\n\n   63 Home Runs\n   0.288 Batting Average\n\n What a year!\n",
        [])
                == "[\"Sammy Sosa completed another fine season with great stats.\\n\\n  63 Home Runs\\n  0.288 Batting Average\\n\\nWhat a year!\\n\"]")

@test
fn test_cases_003() [io]
    test.case("6WLZ")
    test.assert(read_as("# Private\n---\n!foo \"bar\"\n...\n# Global\n%TAG ! tag:example.com,2000:app/\n---\n!foo \"bar\"\n",
        ["!", "!foo"])
                == "[\"bar\",\"bar\"]")
    test.case("6WPF")
    test.assert(read_as("---\n\"\n  foo \n \n    bar\n\n  baz\n\"\n", [])
                == "[\" foo\\nbar\\nbaz \"]")
    test.case("6XDY")
    test.assert(read_as("---\n---\n", [])
                == "[null,null]")
    test.case("6ZKB")
    test.assert(read_as("Document\n---\n# Empty\n...\n%YAML 1.2\n---\nmatches %: 20\n", [])
                == "[\"Document\",null,{\"matches %\":20}]")
    test.case("735Y")
    test.assert(read_as("-\n  \"flow in block\"\n- >\n Block scalar\n- !!map # Block collection\n  foo : bar\n",
        ["!!map"])
                == "[[\"flow in block\",\"Block scalar\\n\",{\"foo\":\"bar\"}]]")
    test.case("74H7")
    test.assert(read_as("!!str a: b\nc: !!int 42\ne: !!str f\ng: h\n!!str 23: !!bool false\n",
        ["!!bool", "!!int", "!!str"])
                == "[{\"a\":\"b\",\"c\":42,\"e\":\"f\",\"g\":\"h\",\"23\":false}]")
    test.case("753E")
    test.assert(read_as("--- |-\n ab\n \n \n...\n", [])
                == "[\"ab\"]")
    test.case("7A4E")
    test.assert(read_as("\" 1st non-empty\n\n 2nd non-empty \n\t3rd non-empty \"\n", [])
                == "[\" 1st non-empty\\n2nd non-empty 3rd non-empty \"]")
    test.case("7BMT")
    test.assert(read_as("---\ntop1: &node1\n  &k1 key1: one\ntop2: &node2 # comment\n  key2: two\ntop3:\n  &k3 key3: three\ntop4: &node4\n  &k4 key4: four\ntop5: &node5\n  key5: five\ntop6: &val6\n  six\ntop7:\n  &val7 seven\n",
        [])
                == "[{\"top1\":{\"key1\":\"one\"},\"top2\":{\"key2\":\"two\"},\"top3\":{\"key3\":\"three\"},\"top4\":{\"key4\":\"four\"},\"top5\":{\"key5\":\"five\"},\"top6\":\"six\",\"top7\":\"seven\"}]")
    test.case("7BUB")
    test.assert(read_as("---\nhr:\n  - Mark McGwire\n  # Following node labeled SS\n  - &SS Sammy Sosa\nrbi:\n  - *SS # Subsequent occurrence\n  - Ken Griffey\n",
        [])
                == "[{\"hr\":[\"Mark McGwire\",\"Sammy Sosa\"],\"rbi\":[\"Sammy Sosa\",\"Ken Griffey\"]}]")
    test.case("7FWL")
    test.assert(read_as("!<tag:yaml.org,2002:str> foo :\n  !<!bar> baz\n", ["!<!bar>", "!<tag:yaml.org,2002:str>"])
                == "[{\"foo\":\"baz\"}]")
    test.case("7LBH")
    test.assert(refused("\"a\\nb\": 1\n\"c\n d\": 1\n", []))
    test.case("7MNF")
    test.assert(refused("top1:\n  key1: val1\ntop2\n", []))
    test.case("7T8X")
    test.assert(read_as(">\n\n folded\n line\n\n next\n line\n   * bullet\n\n   * list\n   * lines\n\n last\n line\n\n# Comment\n",
        [])
                == "[\"\\nfolded line\\nnext line\\n  * bullet\\n\\n  * list\\n  * lines\\n\\nlast line\\n\"]")
    test.case("7TMG")
    test.assert(read_as("---\n[ word1\n# comment\n, word2]\n", [])
                == "[[\"word1\",\"word2\"]]")
    test.case("7W2P")
    test.assert(read_as("? a\n? b\nc:\n", [])
                == "[{\"a\":null,\"b\":null,\"c\":null}]")
    test.case("7Z25")
    test.assert(read_as("---\nscalar1\n...\nkey: value\n", [])
                == "[\"scalar1\",{\"key\":\"value\"}]")
    test.case("7ZZ5")
    test.assert(read_as("---\nnested sequences:\n- - - []\n- - - {}\nkey1: []\nkey2: {}\n", [])
                == "[{\"nested sequences\":[[[[]]],[[{}]]],\"key1\":[],\"key2\":{}}]")
    test.case("82AN")
    test.assert(read_as("---word1\nword2\n", [])
                == "[\"---word1 word2\"]")
    test.case("87E4")
    test.assert(read_as("'implicit block key' : [\n  'implicit flow key' : value,\n ]\n", [])
                == "[{\"implicit block key\":[{\"implicit flow key\":\"value\"}]}]")
    test.case("8CWC")
    test.assert(read_as("---\nkey ends with two colons::: value\n", [])
                == "[{\"key ends with two colons::\":\"value\"}]")
    test.case("8G76")
    test.assert(read_as("  # Comment\n   \n\n\n", [])
                == "[]")
    test.case("8KB6")
    test.assert(read_as("---\n- { single line, a: b}\n- { multi\n  line, a: b}\n", [])
                == "[[{\"single line\":null,\"a\":\"b\"},{\"multi line\":null,\"a\":\"b\"}]]")
    test.case("8MK2")
    test.assert(read_as("! a\n", ["!"])
                == "[\"a\"]")
    test.case("8QBE")
    test.assert(read_as("key:\n - item1\n - item2\n", [])
                == "[{\"key\":[\"item1\",\"item2\"]}]")
    test.case("8UDB")
    test.assert(read_as("[\n\"double\n quoted\", 'single\n           quoted',\nplain\n text, [ nested ],\nsingle: pair,\n]\n",
        [])
                == "[[\"double quoted\",\"single quoted\",\"plain text\",[\"nested\"],{\"single\":\"pair\"}]]")
    test.case("8XDJ")
    test.assert(refused("key: word1\n#  xxx\n  word2\n", []))
    test.case("8XYN")
    test.assert(read_as("---\n- &😁 unicode anchor\n", [])
                == "[[\"unicode anchor\"]]")
    test.case("93JH")
    test.assert(read_as(" - key: value\n   key2: value2\n -\n   key3: value3\n", [])
                == "[[{\"key\":\"value\",\"key2\":\"value2\"},{\"key3\":\"value3\"}]]")
    test.case("93WF")
    test.assert(read_as("--- >-\n  trimmed\n  \n \n\n  as\n  space\n", [])
                == "[\"trimmed\\n\\n\\nas space\"]")
    test.case("96L6")
    test.assert(read_as("--- >\n  Mark McGwire's\n  year was crippled\n  by a knee injury.\n", [])
                == "[\"Mark McGwire's year was crippled by a knee injury.\\n\"]")
    test.case("96NN/00")
    test.assert(read_as("foo: |-\n \tbar\n", [])
                == "[{\"foo\":\"\\tbar\"}]")
    test.case("96NN/01")
    test.assert(read_as("foo: |-\n \tbar", [])
                == "[{\"foo\":\"\\tbar\"}]")
    test.case("98YD")
    test.assert(read_as("# Comment only.\n", [])
                == "[]")
    test.case("9BXH")
    test.assert(read_as("---\n- { \"single line\", a: b}\n- { \"multi\n  line\", a: b}\n", [])
                == "[[{\"single line\":null,\"a\":\"b\"},{\"multi line\":null,\"a\":\"b\"}]]")
    test.case("9C9N")
    test.assert(refused("---\nflow: [a,\nb,\nc]\n", []))
    test.case("9CWY")
    test.assert(refused("key:\n - item1\n - item2\ninvalid\n", []))
    test.case("9DXL")
    test.assert(read_as("Mapping: Document\n---\n# Empty\n...\n%YAML 1.2\n---\nmatches %: 20\n", [])
                == "[{\"Mapping\":\"Document\"},null,{\"matches %\":20}]")
    test.case("9FMG")
    test.assert(read_as("a:\n  b:\n    c: d\n  e:\n    f: g\nh: i\n", [])
                == "[{\"a\":{\"b\":{\"c\":\"d\"},\"e\":{\"f\":\"g\"}},\"h\":\"i\"}]")
    test.case("9HCY")
    test.assert(refused("!foo \"bar\"\n%TAG ! tag:example.com,2000:app/\n---\n!foo \"bar\"\n", ["!", "!foo"]))

@test
fn test_cases_004() [io]
    test.case("9J7A")
    test.assert(read_as("foo:\n  bar: baz\n", [])
                == "[{\"foo\":{\"bar\":\"baz\"}}]")
    test.case("9JBA")
    test.assert(refused("---\n[ a, b, c, ]#invalid\n", []))
    test.case("9KAX")
    test.assert(read_as("---\n&a1\n!!str\nscalar1\n---\n!!str\n&a2\nscalar2\n---\n&a3\n!!str scalar3\n---\n&a4 !!map\n&a5 !!str key5: value4\n---\na6: 1\n&anchor6 b6: 2\n---\n!!map\n&a8 !!str key8: value7\n---\n!!map\n!!str &a10 key10: value9\n---\n!!str &a11\nvalue11\n",
        ["!!map", "!!str"])
                == "[\"scalar1\",\"scalar2\",\"scalar3\",{\"key5\":\"value4\"},{\"a6\":1,\"b6\":2},{\"key8\":\"value7\"},{\"key10\":\"value9\"},\"value11\"]")
    test.case("9KBC")
    test.assert(refused("--- key1: value1\n    key2: value2\n", []))
    test.case("9MAG")
    test.assert(refused("---\n[ , a, b, c ]\n", []))
    test.case("9MMA")
    test.assert(refused("%YAML 1.2\n", []))
    test.case("9MQT/00")
    test.assert(read_as("--- \"a\n...x\nb\"\n", [])
                == "[\"a ...x b\"]")
    test.case("9MQT/01")
    test.assert(refused("--- \"a\n... x\nb\"\n", []))
    test.case("9SA2")
    test.assert(read_as("---\n- { \"single line\": value}\n- { \"multi\n  line\": value}\n", [])
                == "[[{\"single line\":\"value\"},{\"multi line\":\"value\"}]]")
    test.case("9SHH")
    test.assert(read_as("single: 'text'\ndouble: \"text\"\n", [])
                == "[{\"single\":\"text\",\"double\":\"text\"}]")
    test.case("9TFX")
    test.assert(read_as("---\n\" 1st non-empty\n\n 2nd non-empty \n 3rd non-empty \"\n", [])
                == "[\" 1st non-empty\\n2nd non-empty 3rd non-empty \"]")
    test.case("9U5K")
    test.assert(read_as("---\n# Products purchased\n- item    : Super Hoop\n  quantity: 1\n- item    : Basketball\n  quantity: 4\n- item    : Big Shoes\n  quantity: 1\n",
        [])
                == "[[{\"item\":\"Super Hoop\",\"quantity\":1},{\"item\":\"Basketball\",\"quantity\":4},{\"item\":\"Big Shoes\",\"quantity\":1}]]")
    test.case("9WXW")
    test.assert(read_as("# Private\n!foo \"bar\"\n...\n# Global\n%TAG ! tag:example.com,2000:app/\n---\n!foo \"bar\"\n",
        ["!", "!foo"])
                == "[\"bar\",\"bar\"]")
    test.case("9YRD")
    test.assert(read_as("a\nb  \n  c\nd\n\ne\n", [])
                == "[\"a b c d\\ne\"]")
    test.case("A2M4")
    test.assert(read_as("? a\n: -\tb\n  -  -\tc\n     - d\n", [])
                == "[{\"a\":[\"b\",[\"c\",\"d\"]]}]")
    test.case("A6F9")
    test.assert(read_as("strip: |-\n  text\nclip: |\n  text\nkeep: |+\n  text\n", [])
                == "[{\"strip\":\"text\",\"clip\":\"text\\n\",\"keep\":\"text\\n\"}]")
    test.case("A984")
    test.assert(read_as("a: b\n c\nd:\n e\n  f\n", [])
                == "[{\"a\":\"b c\",\"d\":\"e f\"}]")
    test.case("AB8U")
    test.assert(read_as("- single multiline\n - sequence entry\n", [])
                == "[[\"single multiline - sequence entry\"]]")
    test.case("AVM7")
    test.assert(read_as("", [])
                == "[]")
    test.case("AZ63")
    test.assert(read_as("one:\n- 2\n- 3\nfour: 5\n", [])
                == "[{\"one\":[2,3],\"four\":5}]")
    test.case("AZW3")
    test.assert(read_as("- bla\"keks: foo\n- bla]keks: foo\n", [])
                == "[[{\"bla\\\"keks\":\"foo\"},{\"bla]keks\":\"foo\"}]]")
    test.case("B3HG")
    test.assert(read_as("--- >\n folded\n text\n\n\n", [])
                == "[\"folded text\\n\"]")
    test.case("B63P")
    test.assert(refused("%YAML 1.2\n...\n", []))
    test.case("BD7L")
    test.assert(refused("- item1\n- item2\ninvalid: x\n", []))
    test.case("BEC7")
    test.assert(read_as("%YAML 1.3 # Attempt parsing\n          # with a warning\n---\n\"foo\"\n", [])
                == "[\"foo\"]")
    test.case("BF9H")
    test.assert(refused("---\nplain: a\n       b # end of scalar\n       c\n", []))
    test.case("BS4K")
    test.assert(refused("word1  # comment\nword2\n", []))
    test.case("BU8L")
    test.assert(read_as("key: &anchor\n !!map\n  a: b\n", ["!!map"])
                == "[{\"key\":{\"a\":\"b\"}}]")
    test.case("C2DT")
    test.assert(read_as("{\n\"adjacent\":value,\n\"readable\": value,\n\"empty\":\n}\n", [])
                == "[{\"adjacent\":\"value\",\"readable\":\"value\",\"empty\":null}]")
    test.case("C2SP")
    test.assert(refused("[23\n]: 42\n", []))
    test.case("C4HZ")
    test.assert(read_as("%TAG ! tag:clarkevans.com,2002:\n--- !shape\n  # Use the ! handle for presenting\n  # tag:clarkevans.com,2002:circle\n- !circle\n  center: &ORIGIN {x: 73, y: 129}\n  radius: 7\n- !line\n  start: *ORIGIN\n  finish: { x: 89, y: 102 }\n- !label\n  start: *ORIGIN\n  color: 0xFFEEBB\n  text: Pretty vector drawing.\n",
        ["!", "!circle", "!label", "!line", "!shape"])
                == "[[{\"center\":{\"x\":73,\"y\":129},\"radius\":7},{\"start\":{\"x\":73,\"y\":129},\"finish\":{\"x\":89,\"y\":102}},{\"start\":{\"x\":73,\"y\":129},\"color\":16772795,\"text\":\"Pretty vector drawing.\"}]]")
    test.case("CC74")
    test.assert(read_as("%TAG !e! tag:example.com,2000:app/\n---\n!e!foo \"bar\"\n", ["!e!", "!e!foo"])
                == "[\"bar\"]")
    test.case("CML9")
    test.assert(refused("key: [ word1\n#  xxx\n  word2 ]\n", []))
    test.case("CN3R")
    test.assert(read_as("&flowseq [\n a: b,\n &c c: d,\n { &e e: f },\n &g { g: h }\n]\n", [])
                == "[[{\"a\":\"b\"},{\"c\":\"d\"},{\"e\":\"f\"},{\"g\":\"h\"}]]")
    test.case("CPZ3")
    test.assert(read_as("---\ntab: \"\\tstring\"\n", [])
                == "[{\"tab\":\"\\tstring\"}]")
    test.case("CQ3W")
    test.assert(refused("---\nkey: \"missing closing quote\n", []))
    test.case("CT4Q")
    test.assert(read_as("[\n? foo\n bar : baz\n]\n", [])
                == "[[{\"foo bar\":\"baz\"}]]")
    test.case("CTN5")
    test.assert(refused("---\n[ a, b, c, , ]\n", []))
    test.case("CUP7")
    test.assert(read_as("anchored: !local &anchor value\nalias: *anchor\n", ["!local"])
                == "[{\"anchored\":\"value\",\"alias\":\"value\"}]")
    test.case("CVW2")
    test.assert(refused("---\n[ a, b, c,#invalid\n]\n", []))

@test
fn test_cases_005() [io]
    test.case("CXX2")
    test.assert(refused("--- &anchor a: b\n", []))
    test.case("D49Q")
    test.assert(refused("'a\\nb': 1\n'c\n d': 1\n", []))
    test.case("D83L")
    test.assert(read_as("- |2-\n  explicit indent and chomp\n- |-2\n  chomp and explicit indent\n", [])
                == "[[\"explicit indent and chomp\",\"chomp and explicit indent\"]]")
    test.case("D88J")
    test.assert(read_as("a: [b, c]\n", [])
                == "[{\"a\":[\"b\",\"c\"]}]")
    test.case("D9TU")
    test.assert(read_as("foo: bar\n", [])
                == "[{\"foo\":\"bar\"}]")
    test.case("DBG4")
    test.assert(read_as("# Outside flow collection:\n- ::vector\n- \": - ()\"\n- Up, up, and away!\n- -123\n- http://example.com/foo#bar\n# Inside flow collection:\n- [ ::vector,\n  \": - ()\",\n  \"Up, up and away!\",\n  -123,\n  http://example.com/foo#bar ]\n",
        [])
                == "[[\"::vector\",\": - ()\",\"Up, up, and away!\",-123,\"http://example.com/foo#bar\",[\"::vector\",\": - ()\",\"Up, up and away!\",-123,\"http://example.com/foo#bar\"]]]")
    test.case("DC7X")
    test.assert(read_as("a: b\t\nseq:\t\n - a\t\nc: d\t#X\n", [])
                == "[{\"a\":\"b\",\"seq\":[\"a\"],\"c\":\"d\"}]")
    test.case("DE56/00")
    test.assert(read_as("\"1 trailing\\t\n    tab\"\n", [])
                == "[\"1 trailing\\t tab\"]")
    test.case("DE56/01")
    test.assert(read_as("\"2 trailing\\t  \n    tab\"\n", [])
                == "[\"2 trailing\\t tab\"]")
    test.case("DE56/02")
    test.assert(read_as("\"3 trailing\\\t\n    tab\"\n", [])
                == "[\"3 trailing\\t tab\"]")
    test.case("DE56/03")
    test.assert(read_as("\"4 trailing\\\t  \n    tab\"\n", [])
                == "[\"4 trailing\\t tab\"]")
    test.case("DE56/04")
    test.assert(read_as("\"5 trailing\t\n    tab\"\n", [])
                == "[\"5 trailing tab\"]")
    test.case("DE56/05")
    test.assert(read_as("\"6 trailing\t  \n    tab\"\n", [])
                == "[\"6 trailing tab\"]")
    test.case("DHP8")
    test.assert(read_as("[foo, bar, 42]\n", [])
                == "[[\"foo\",\"bar\",42]]")
    test.case("DK3J")
    test.assert(read_as("--- >\nline1\n# no comment\nline3\n", [])
                == "[\"line1 # no comment line3\\n\"]")
    test.case("DK4H")
    test.assert(refused("---\n[ key\n  : value ]\n", []))
    test.case("DK95/00")
    test.assert(read_as("foo:\n \tbar\n", [])
                == "[{\"foo\":\"bar\"}]")
    test.case("DK95/01")
    test.assert(refused("foo: \"bar\n\tbaz\"\n", []))
    test.case("DK95/02")
    test.assert(read_as("foo: \"bar\n  \tbaz\"\n", [])
                == "[{\"foo\":\"bar baz\"}]")
    test.case("DK95/03")
    test.assert(read_as(" \t\nfoo: 1\n", [])
                == "[{\"foo\":1}]")
    test.case("DK95/04")
    test.assert(read_as("foo: 1\n\t\nbar: 2\n", [])
                == "[{\"foo\":1,\"bar\":2}]")
    test.case("DK95/05")
    test.assert(read_as("foo: 1\n \t\nbar: 2\n", [])
                == "[{\"foo\":1,\"bar\":2}]")
    test.case("DK95/06")
    test.assert(refused("foo:\n  a: 1\n  \tb: 2\n", []))
    test.case("DK95/07")
    test.assert(read_as("%YAML 1.2\n\t\n---\n", [])
                == "[null]")
    test.case("DK95/08")
    test.assert(read_as("foo: \"bar\n \t \t baz \t \t \"\n", [])
                == "[{\"foo\":\"bar baz \\t \\t \"}]")
    test.case("DMG6")
    test.assert(refused("key:\n  ok: 1\n wrong: 2\n", []))
    test.case("DWX9")
    test.assert(read_as("|\n \n  \n  literal\n   \n  \n  text\n\n # Comment\n", [])
                == "[\"\\n\\nliteral\\n \\n\\ntext\\n\"]")
    test.case("E76Z")
    test.assert(read_as("&a a: &b b\n*b : *a\n", [])
                == "[{\"a\":\"b\",\"b\":\"a\"}]")
    test.case("EB22")
    test.assert(refused("---\nscalar1 # comment\n%YAML 1.2\n---\nscalar2\n", []))
    test.case("EHF6")
    test.assert(read_as("!!map {\n  k: !!seq\n  [ a, !!str b]\n}\n", ["!!map", "!!seq", "!!str"])
                == "[{\"k\":[\"a\",\"b\"]}]")
    test.case("EW3V")
    test.assert(refused("k1: v1\n k2: v2\n", []))
    test.case("EX5H")
    test.assert(read_as("---\na\nb  \n  c\nd\n\ne\n", [])
                == "[\"a b c d\\ne\"]")
    test.case("EXG3")
    test.assert(read_as("---\n---word1\nword2\n", [])
                == "[\"---word1 word2\"]")
    test.case("F2C7")
    test.assert(read_as(" - &a !!str a\n - !!int 2\n - !!int &c 4\n - &d d\n", ["!!int", "!!str"])
                == "[[\"a\",2,4,\"d\"]]")
    test.case("F3CP")
    test.assert(read_as("---\n{ a: [b, c, { d: [e, f] } ] }\n", [])
                == "[{\"a\":[\"b\",\"c\",{\"d\":[\"e\",\"f\"]}]}]")
    test.case("F6MC")
    test.assert(read_as("---\na: >2\n   more indented\n  regular\nb: >2\n\n\n   more indented\n  regular\n", [])
                == "[{\"a\":\" more indented\\nregular\\n\",\"b\":\"\\n\\n more indented\\nregular\\n\"}]")
    test.case("F8F9")
    test.assert(read_as(" # Strip\n  # Comments:\nstrip: |-\n  # text\n  \n # Clip\n  # comments:\n\nclip: |\n  # text\n \n # Keep\n  # comments:\n\nkeep: |+\n  # text\n\n # Trail\n  # comments.\n",
        [])
                == "[{\"strip\":\"# text\",\"clip\":\"# text\\n\",\"keep\":\"# text\\n\\n\"}]")
    test.case("FBC9")
    test.assert(read_as("safe: a!\"#\$%&'()*+,-./09:;<=>?@AZ[\\]^_`az{|}~\n     !\"#\$%&'()*+,-./09:;<=>?@AZ[\\]^_`az{|}~\nsafe question mark: ?foo\nsafe colon: :foo\nsafe dash: -foo\n",
        ["!\"#\$%&'()*+"])
                == "[{\"safe\":\"a!\\\"#\$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az{|}~ !\\\"#\$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az{|}~\",\"safe question mark\":\"?foo\",\"safe colon\":\":foo\",\"safe dash\":\"-foo\"}]")
    test.case("FP8R")
    test.assert(read_as("--- >\nline1\nline2\nline3\n", [])
                == "[\"line1 line2 line3\\n\"]")
    test.case("FQ7F")
    test.assert(read_as("- Mark McGwire\n- Sammy Sosa\n- Ken Griffey\n", [])
                == "[[\"Mark McGwire\",\"Sammy Sosa\",\"Ken Griffey\"]]")

@test
fn test_cases_006() [io]
    test.case("FTA2")
    test.assert(read_as("--- &sequence\n- a\n", [])
                == "[[\"a\"]]")
    test.case("FUP4")
    test.assert(read_as("[a, [b, c]]\n", [])
                == "[[\"a\",[\"b\",\"c\"]]]")
    test.case("G4RS")
    test.assert(read_as("unicode: \"Sosa did fine.\\u263A\"\ncontrol: \"\\b1998\\t1999\\t2000\\n\"\nhex esc: \"\\x0d\\x0a is \\r\\n\"\n\nsingle: '\"Howdy!\" he cried.'\nquoted: ' # Not a ''comment''.'\ntie-fighter: '|\\-*-/|'\n",
        [])
                == "[{\"unicode\":\"Sosa did fine.☺\",\"control\":\"\\u00081998\\t1999\\t2000\\n\",\"hex esc\":\"\\r\\n is \\r\\n\",\"single\":\"\\\"Howdy!\\\" he cried.\",\"quoted\":\" # Not a 'comment'.\",\"tie-fighter\":\"|\\\\-*-/|\"}]")
    test.case("G5U8")
    test.assert(refused("---\n- [-, -]\n", []))
    test.case("G7JE")
    test.assert(refused("a\\nb: 1\nc\n d: 1\n", []))
    test.case("G992")
    test.assert(read_as(">\n folded\n text\n\n\n", [])
                == "[\"folded text\\n\"]")
    test.case("G9HC")
    test.assert(refused("---\nseq:\n&anchor\n- a\n- b\n", []))
    test.case("GDY7")
    test.assert(refused("key: value\nthis is #not a: key\n", []))
    test.case("GH63")
    test.assert(read_as("? a\n: 1.3\nfifteen: d\n", [])
                == "[{\"a\":1.3,\"fifteen\":\"d\"}]")
    test.case("GT5M")
    test.assert(refused("- item1\n&node\n- item2\n", []))
    test.case("H2RW")
    test.assert(read_as("foo: 1\n\nbar: 2\n    \ntext: |\n  a\n    \n  b\n\n  c\n \n  d\n", [])
                == "[{\"foo\":1,\"bar\":2,\"text\":\"a\\n  \\nb\\n\\nc\\n\\nd\\n\"}]")
    test.case("H3Z8")
    test.assert(read_as("---\nwanted: love ♥ and peace ☮\n", [])
                == "[{\"wanted\":\"love ♥ and peace ☮\"}]")
    test.case("H7J7")
    test.assert(refused("key: &x\n!!map\n  a: b\n", ["!!map"]))
    test.case("H7TQ")
    test.assert(refused("%YAML 1.2 foo\n---\n", []))
    test.case("HM87/00")
    test.assert(read_as("[:x]\n", [])
                == "[[\":x\"]]")
    test.case("HM87/01")
    test.assert(read_as("[?x]\n", [])
                == "[[\"?x\"]]")
    test.case("HMK4")
    test.assert(read_as("name: Mark McGwire\naccomplishment: >\n  Mark set a major league\n  home run record in 1998.\nstats: |\n  65 Home Runs\n  0.278 Batting Average\n",
        [])
                == "[{\"name\":\"Mark McGwire\",\"accomplishment\":\"Mark set a major league home run record in 1998.\\n\",\"stats\":\"65 Home Runs\\n0.278 Batting Average\\n\"}]")
    test.case("HMQ5")
    test.assert(read_as("!!str &a1 \"foo\":\n  !!str bar\n&a2 baz : *a1\n", ["!!str"])
                == "[{\"foo\":\"bar\",\"baz\":\"foo\"}]")
    test.case("HRE5")
    test.assert(refused("---\ndouble: \"quoted \\' scalar\"\n", []))
    test.case("HS5T")
    test.assert(read_as("1st non-empty\n\n 2nd non-empty \n\t3rd non-empty\n", [])
                == "[\"1st non-empty\\n2nd non-empty 3rd non-empty\"]")
    test.case("HU3P")
    test.assert(refused("key:\n  word1 word2\n  no: key\n", []))
    test.case("HWV9")
    test.assert(read_as("...\n", [])
                == "[]")
    test.case("J3BT")
    test.assert(read_as("# Tabs and spaces\nquoted: \"Quoted \t\"\nblock:\t|\n  void main() {\n  \tprintf(\"Hello, world!\\n\");\n  }\n",
        [])
                == "[{\"quoted\":\"Quoted \\t\",\"block\":\"void main() {\\n\\tprintf(\\\"Hello, world!\\\\n\\\");\\n}\\n\"}]")
    test.case("J5UC")
    test.assert(read_as("foo: blue\nbar: arrr\nbaz: jazz\n", [])
                == "[{\"foo\":\"blue\",\"bar\":\"arrr\",\"baz\":\"jazz\"}]")
    test.case("J7PZ")
    test.assert(read_as("# The !!omap tag is one of the optional types\n# introduced for YAML 1.1. In 1.2, it is not\n# part of the standard tags and should not be\n# enabled by default.\n# Ordered maps are represented as\n# A sequence of mappings, with\n# each mapping having one key\n--- !!omap\n- Mark McGwire: 65\n- Sammy Sosa: 63\n- Ken Griffy: 58\n",
        ["!!omap"])
                == "[[{\"Mark McGwire\":65},{\"Sammy Sosa\":63},{\"Ken Griffy\":58}]]")
    test.case("J7VC")
    test.assert(read_as("one: 2\n\n\nthree: 4\n", [])
                == "[{\"one\":2,\"three\":4}]")
    test.case("J9HZ")
    test.assert(read_as("---\nhr: # 1998 hr ranking\n  - Mark McGwire\n  - Sammy Sosa\nrbi:\n  # 1998 rbi ranking\n  - Sammy Sosa\n  - Ken Griffey\n",
        [])
                == "[{\"hr\":[\"Mark McGwire\",\"Sammy Sosa\"],\"rbi\":[\"Sammy Sosa\",\"Ken Griffey\"]}]")
    test.case("JEF9/00")
    test.assert(read_as("- |+\n\n\n", [])
                == "[[\"\\n\\n\"]]")
    test.case("JEF9/01")
    test.assert(read_as("- |+\n   \n", [])
                == "[[\"\\n\"]]")
    test.case("JEF9/02")
    test.assert(read_as("- |+\n   ", [])
                == "[[\"\\n\"]]")
    test.case("JHB9")
    test.assert(read_as("# Ranking of 1998 home runs\n---\n- Mark McGwire\n- Sammy Sosa\n- Ken Griffey\n\n# Team ranking\n---\n- Chicago Cubs\n- St Louis Cardinals\n",
        [])
                == "[[\"Mark McGwire\",\"Sammy Sosa\",\"Ken Griffey\"],[\"Chicago Cubs\",\"St Louis Cardinals\"]]")
    test.case("JKF3")
    test.assert(refused("- - \"bar\nbar\": x\n", []))
    test.case("JQ4R")
    test.assert(read_as("block sequence:\n  - one\n  - two : three\n", [])
                == "[{\"block sequence\":[\"one\",{\"two\":\"three\"}]}]")
    test.case("JR7V")
    test.assert(read_as("- a?string\n- another ? string\n- key: value?\n- [a?string]\n- [another ? string]\n- {key: value? }\n- {key: value?}\n- {key?: value }\n",
        [])
                == "[[\"a?string\",\"another ? string\",{\"key\":\"value?\"},[\"a?string\"],[\"another ? string\"],{\"key\":\"value?\"},{\"key\":\"value?\"},{\"key?\":\"value\"}]]")
    test.case("JS2J")
    test.assert(read_as("First occurrence: &anchor Value\nSecond occurrence: *anchor\n", [])
                == "[{\"First occurrence\":\"Value\",\"Second occurrence\":\"Value\"}]")
    test.case("JTV5")
    test.assert(read_as("? a\n  true\n: null\n  d\n? e\n  42\n", [])
                == "[{\"a true\":\"null d\",\"e 42\":null}]")
    test.case("JY7Z")
    test.assert(refused("key1: \"quoted1\"\nkey2: \"quoted2\" no key: nor value\nkey3: \"quoted3\"\n", []))
    test.case("K3WX")
    test.assert(read_as("---\n{ \"foo\" # comment\n  :bar }\n", [])
                == "[{\"foo\":\"bar\"}]")
    test.case("K4SU")
    test.assert(read_as("- foo\n- bar\n- 42\n", [])
                == "[[\"foo\",\"bar\",42]]")
    test.case("K527")
    test.assert(read_as(">-\n  trimmed\n  \n \n\n  as\n  space\n", [])
                == "[\"trimmed\\n\\n\\nas space\"]")

@test
fn test_cases_007() [io]
    test.case("K54U")
    test.assert(read_as("---\tscalar\n", [])
                == "[\"scalar\"]")
    test.case("K858")
    test.assert(read_as("strip: >-\n\nclip: >\n\nkeep: |+\n\n", [])
                == "[{\"strip\":\"\",\"clip\":\"\",\"keep\":\"\\n\"}]")
    test.case("KH5V/00")
    test.assert(read_as("\"1 inline\\ttab\"\n", [])
                == "[\"1 inline\\ttab\"]")
    test.case("KH5V/01")
    test.assert(read_as("\"2 inline\\\ttab\"\n", [])
                == "[\"2 inline\\ttab\"]")
    test.case("KH5V/02")
    test.assert(read_as("\"3 inline\ttab\"\n", [])
                == "[\"3 inline\\ttab\"]")
    test.case("KMK3")
    test.assert(read_as("foo:\n  bar: 1\nbaz: 2\n", [])
                == "[{\"foo\":{\"bar\":1},\"baz\":2}]")
    test.case("KS4U")
    test.assert(refused("---\n[\nsequence item\n]\ninvalid item\n", []))
    test.case("KSS4")
    test.assert(read_as("--- \"quoted\nstring\"\n--- &node foo\n", [])
                == "[\"quoted string\",\"foo\"]")
    test.case("L24T/00")
    test.assert(read_as("foo: |\n  x\n   \n", [])
                == "[{\"foo\":\"x\\n \\n\"}]")
    test.case("L24T/01")
    test.assert(read_as("foo: |\n  x\n   ", [])
                == "[{\"foo\":\"x\\n \\n\"}]")
    test.case("L383")
    test.assert(read_as("--- foo  # comment\n--- foo  # comment\n", [])
                == "[\"foo\",\"foo\"]")
    test.case("L94M")
    test.assert(read_as("? !!str a\n: !!int 47\n? c\n: !!str d\n", ["!!int", "!!str"])
                == "[{\"a\":47,\"c\":\"d\"}]")
    test.case("L9U5")
    test.assert(read_as("implicit block key : [\n  implicit flow key : value,\n ]\n", [])
                == "[{\"implicit block key\":[{\"implicit flow key\":\"value\"}]}]")
    test.case("LE5A")
    test.assert(read_as("- !!str \"a\"\n- 'b'\n- &anchor \"c\"\n- *anchor\n- !!str\n", ["!!str"])
                == "[[\"a\",\"b\",\"c\",\"c\",\"\"]]")
    test.case("LHL4")
    test.assert(refused("---\n!invalid{}tag scalar\n", ["!invalid"]))
    test.case("LP6E")
    test.assert(read_as("- [a, b , c ]\n- { \"a\"  : b\n   , c : 'd' ,\n   e   : \"f\"\n  }\n- [      ]\n", [])
                == "[[[\"a\",\"b\",\"c\"],{\"a\":\"b\",\"c\":\"d\",\"e\":\"f\"},[]]]")
    test.case("LQZ7")
    test.assert(read_as("\"implicit block key\" : [\n  \"implicit flow key\" : value,\n ]\n", [])
                == "[{\"implicit block key\":[{\"implicit flow key\":\"value\"}]}]")
    test.case("M29M")
    test.assert(read_as("a: |\n ab\n \n cd\n ef\n \n\n...\n", [])
                == "[{\"a\":\"ab\\n\\ncd\\nef\\n\"}]")
    test.case("M5C3")
    test.assert(read_as("literal: |2\n  value\nfolded:\n   !foo\n  >1\n value\n", ["!foo"])
                == "[{\"literal\":\"value\\n\",\"folded\":\"value\\n\"}]")
    test.case("M6YH")
    test.assert(read_as("- |\n x\n-\n foo: bar\n-\n - 42\n", [])
                == "[[\"x\\n\",{\"foo\":\"bar\"},[42]]]")
    test.case("M7A3")
    test.assert(read_as("Bare\ndocument\n...\n# No document\n...\n|\n%!PS-Adobe-2.0 # Not the first line\n", [])
                == "[\"Bare document\",\"%!PS-Adobe-2.0 # Not the first line\\n\"]")
    test.case("M7NX")
    test.assert(read_as("---\n{\n a: [\n  b, c, {\n   d: [e, f]\n  }\n ]\n}\n", [])
                == "[{\"a\":[\"b\",\"c\",{\"d\":[\"e\",\"f\"]}]}]")
    test.case("M9B4")
    test.assert(read_as("|\n literal\n \ttext\n\n\n", [])
                == "[\"literal\\n\\ttext\\n\"]")
    test.case("MJS9")
    test.assert(read_as(">\n  foo \n \n  \t bar\n\n  baz\n", [])
                == "[\"foo \\n\\n\\t bar\\n\\nbaz\\n\"]")
    test.case("MUS6/00")
    test.assert(refused("%YAML 1.1#...\n---\n", []))
    test.case("MUS6/01")
    test.assert(refused("%YAML 1.2\n---\n%YAML 1.2\n---\n", []))
    test.case("MUS6/02")
    test.assert(read_as("%YAML  1.1\n---\n", [])
                == "[null]")
    test.case("MUS6/03")
    test.assert(read_as("%YAML \t 1.1\n---\n", [])
                == "[null]")
    test.case("MUS6/04")
    test.assert(read_as("%YAML 1.1  # comment\n---\n", [])
                == "[null]")
    test.case("MUS6/05")
    test.assert(read_as("%YAM 1.1\n---\n", [])
                == "[null]")
    test.case("MUS6/06")
    test.assert(read_as("%YAMLL 1.1\n---\n", [])
                == "[null]")
    test.case("MXS3")
    test.assert(read_as("- {a: b}\n", [])
                == "[[{\"a\":\"b\"}]]")
    test.case("MYW6")
    test.assert(read_as("|-\n ab\n \n \n...\n", [])
                == "[\"ab\"]")
    test.case("MZX3")
    test.assert(read_as("- plain\n- \"double quoted\"\n- 'single quoted'\n- >\n  block\n- plain again\n", [])
                == "[[\"plain\",\"double quoted\",\"single quoted\",\"block\\n\",\"plain again\"]]")
    test.case("N4JP")
    test.assert(refused("map:\n  key1: \"quoted1\"\n key2: \"bad indentation\"\n", []))
    test.case("N782")
    test.assert(refused("[\n--- ,\n...\n]\n", []))
    test.case("NAT4")
    test.assert(read_as("---\na: '\n  '\nb: '  \n  '\nc: \"\n  \"\nd: \"  \n  \"\ne: '\n\n  '\nf: \"\n\n  \"\ng: '\n\n\n  '\nh: \"\n\n\n  \"\n",
        [])
                == "[{\"a\":\" \",\"b\":\" \",\"c\":\" \",\"d\":\" \",\"e\":\"\\n\",\"f\":\"\\n\",\"g\":\"\\n\\n\",\"h\":\"\\n\\n\"}]")
    test.case("NB6Z")
    test.assert(read_as("key:\n  value\n  with\n  \t\n  tabs\n", [])
                == "[{\"key\":\"value with\\ntabs\"}]")
    test.case("NJ66")
    test.assert(read_as("---\n- { single line: value}\n- { multi\n  line: value}\n", [])
                == "[[{\"single line\":\"value\"},{\"multi line\":\"value\"}]]")
    test.case("NP9H")
    test.assert(read_as("\"folded \nto a space,\t\n \nto a line feed, or \t\\\n \\ \tnon-content\"\n", [])
                == "[\"folded to a space,\\nto a line feed, or \\t \\tnon-content\"]")

@test
fn test_cases_008() [io]
    test.case("P2AD")
    test.assert(read_as("- | # Empty header↓\n literal\n- >1 # Indentation indicator↓\n  folded\n- |+ # Chomping indicator↓\n keep\n\n- >1- # Both indicators↓\n  strip\n",
        [])
                == "[[\"literal\\n\",\" folded\\n\",\"keep\\n\\n\",\" strip\"]]")
    test.case("P2EQ")
    test.assert(refused("---\n- { y: z }- invalid\n", []))
    test.case("P76L")
    test.assert(read_as("%TAG !! tag:example.com,2000:app/\n---\n!!int 1 - 3 # Interval, not integer\n",
        ["!!", "!!int"])
                == "[\"1 - 3\"]")
    test.case("P94K")
    test.assert(read_as("key:    # Comment\n        # lines\n  value\n\n\n", [])
                == "[{\"key\":\"value\"}]")
    test.case("PBJ2")
    test.assert(read_as("american:\n  - Boston Red Sox\n  - Detroit Tigers\n  - New York Yankees\nnational:\n  - New York Mets\n  - Chicago Cubs\n  - Atlanta Braves\n",
        [])
                == "[{\"american\":[\"Boston Red Sox\",\"Detroit Tigers\",\"New York Yankees\"],\"national\":[\"New York Mets\",\"Chicago Cubs\",\"Atlanta Braves\"]}]")
    test.case("PRH3")
    test.assert(read_as("' 1st non-empty\n\n 2nd non-empty \n\t3rd non-empty '\n", [])
                == "[\" 1st non-empty\\n2nd non-empty 3rd non-empty \"]")
    test.case("PUW8")
    test.assert(read_as("---\na: b\n---\n", [])
                == "[{\"a\":\"b\"},null]")
    test.case("Q4CL")
    test.assert(refused("key1: \"quoted1\"\nkey2: \"quoted2\" trailing content\nkey3: \"quoted3\"\n", []))
    test.case("Q5MG")
    test.assert(read_as("\t{}\n", [])
                == "[{}]")
    test.case("Q88A")
    test.assert(read_as("- [ a, b ]\n- { a: b }\n- \"a\"\n- 'b'\n- c\n", [])
                == "[[[\"a\",\"b\"],{\"a\":\"b\"},\"a\",\"b\",\"c\"]]")
    test.case("Q8AD")
    test.assert(read_as("---\n\"folded \nto a space,\n \nto a line feed, or \t\\\n \\ \tnon-content\"\n", [])
                == "[\"folded to a space,\\nto a line feed, or \\t \\tnon-content\"]")
    test.case("QB6E")
    test.assert(refused("---\nquoted: \"a\nb\nc\"\n", []))
    test.case("QF4Y")
    test.assert(read_as("[\nfoo: bar\n]\n", [])
                == "[[{\"foo\":\"bar\"}]]")
    test.case("QLJ7")
    test.assert(refused("%TAG !prefix! tag:example.com,2011:\n--- !prefix!A\na: b\n--- !prefix!B\nc: d\n--- !prefix!C\ne: f\n",
        ["!prefix!", "!prefix!A", "!prefix!B", "!prefix!C"]))
    test.case("QT73")
    test.assert(read_as("# comment\n...\n", [])
                == "[]")
    test.case("R4YG")
    test.assert(read_as("- |\n detected\n- >\n \n  \n  # detected\n- |1\n  explicit\n- >\n \t\n detected\n", [])
                == "[[\"detected\\n\",\"\\n\\n# detected\\n\",\" explicit\\n\",\"\\t\\ndetected\\n\"]]")
    test.case("R52L")
    test.assert(read_as("---\n{ top1: [item1, {key2: value2}, item3], top2: value2 }\n", [])
                == "[{\"top1\":[\"item1\",{\"key2\":\"value2\"},\"item3\"],\"top2\":\"value2\"}]")
    test.case("RHX7")
    test.assert(refused("---\nkey: value\n%YAML 1.2\n---\n", []))
    test.case("RLU9")
    test.assert(read_as("foo:\n- 42\nbar:\n  - 44\n", [])
                == "[{\"foo\":[42],\"bar\":[44]}]")
    test.case("RR7F")
    test.assert(read_as("a: 4.2\n? d\n: 23\n", [])
                == "[{\"a\":4.2,\"d\":23}]")
    test.case("RTP8")
    test.assert(read_as("%YAML 1.2\n---\nDocument\n... # Suffix\n", [])
                == "[\"Document\"]")
    test.case("RXY3")
    test.assert(refused("---\n'\n...\n'\n", []))
    test.case("RZT7")
    test.assert(read_as("---\nTime: 2001-11-23 15:01:42 -5\nUser: ed\nWarning:\n  This is an error message\n  for the log file\n---\nTime: 2001-11-23 15:02:31 -5\nUser: ed\nWarning:\n  A slightly different error\n  message.\n---\nDate: 2001-11-23 15:03:17 -5\nUser: ed\nFatal:\n  Unknown variable \"bar\"\nStack:\n  - file: TopClass.py\n    line: 23\n    code: |\n      x = MoreObject(\"345\\n\")\n  - file: MoreClass.py\n    line: 58\n    code: |-\n      foo = bar\n",
        [])
                == "[{\"Time\":\"2001-11-23 15:01:42 -5\",\"User\":\"ed\",\"Warning\":\"This is an error message for the log file\"},{\"Time\":\"2001-11-23 15:02:31 -5\",\"User\":\"ed\",\"Warning\":\"A slightly different error message.\"},{\"Date\":\"2001-11-23 15:03:17 -5\",\"User\":\"ed\",\"Fatal\":\"Unknown variable \\\"bar\\\"\",\"Stack\":[{\"file\":\"TopClass.py\",\"line\":23,\"code\":\"x = MoreObject(\\\"345\\\\n\\\")\\n\"},{\"file\":\"MoreClass.py\",\"line\":58,\"code\":\"foo = bar\"}]}]")
    test.case("S4GJ")
    test.assert(refused("---\nfolded: > first line\n  second line\n", []))
    test.case("S4JQ")
    test.assert(read_as("# Assuming conventional resolution:\n- \"12\"\n- 12\n- ! 12\n", ["!"])
                == "[[\"12\",12,\"12\"]]")
    test.case("S4T7")
    test.assert(read_as("aaa: bbb\n...\n", [])
                == "[{\"aaa\":\"bbb\"}]")
    test.case("S7BG")
    test.assert(read_as("---\n- :,\n", [])
                == "[[\":,\"]]")
    test.case("S98Z")
    test.assert(refused("empty block scalar: >\n \n  \n   \n # comment\n", []))
    test.case("S9E8")
    test.assert(read_as("sequence:\n- one\n- two\nmapping:\n  ? sky\n  : blue\n  sea : green\n", [])
                == "[{\"sequence\":[\"one\",\"two\"],\"mapping\":{\"sky\":\"blue\",\"sea\":\"green\"}}]")
    test.case("SF5V")
    test.assert(refused("%YAML 1.2\n%YAML 1.2\n---\n", []))
    test.case("SKE5")
    test.assert(read_as("---\nseq:\n &anchor\n- a\n- b\n", [])
                == "[{\"seq\":[\"a\",\"b\"]}]")
    test.case("SM9W/00")
    test.assert(read_as("-", [])
                == "[[null]]")
    test.case("SR86")
    test.assert(refused("key1: &a value\nkey2: &b *a\n", []))
    test.case("SSW6")
    test.assert(read_as("---\n'here''s to \"quotes\"'\n", [])
                == "[\"here's to \\\"quotes\\\"\"]")
    test.case("SU5Z")
    test.assert(refused("key: \"value\"# invalid comment\n", []))
    test.case("SU74")
    test.assert(refused("key1: &alias value1\n&b *alias : value2\n", []))
    test.case("SY6V")
    test.assert(refused("&anchor - sequence entry\n", []))
    test.case("SYW4")
    test.assert(read_as("hr:  65    # Home runs\navg: 0.278 # Batting average\nrbi: 147   # Runs Batted In\n", [])
                == "[{\"hr\":65,\"avg\":0.278,\"rbi\":147}]")
    test.case("T26H")
    test.assert(read_as("--- |\n \n  \n  literal\n   \n  \n  text\n\n # Comment\n", [])
                == "[\"\\n\\nliteral\\n \\n\\ntext\\n\"]")
    test.case("T4YY")
    test.assert(read_as("---\n' 1st non-empty\n\n 2nd non-empty \n 3rd non-empty '\n", [])
                == "[\" 1st non-empty\\n2nd non-empty 3rd non-empty \"]")

@test
fn test_cases_009() [io]
    test.case("T5N4")
    test.assert(read_as("--- |\n literal\n \ttext\n\n\n", [])
                == "[\"literal\\n\\ttext\\n\"]")
    test.case("T833")
    test.assert(refused("---\n{\n foo: 1\n bar: 2 }\n", []))
    test.case("TD5N")
    test.assert(refused("- item1\n- item2\ninvalid\n", []))
    test.case("TE2A")
    test.assert(read_as("block mapping:\n key: value\n", [])
                == "[{\"block mapping\":{\"key\":\"value\"}}]")
    test.case("TL85")
    test.assert(read_as("\"\n  foo \n \n  \t bar\n\n  baz\n\"\n", [])
                == "[\" foo\\nbar\\nbaz \"]")
    test.case("TS54")
    test.assert(read_as(">\n ab\n cd\n \n ef\n\n\n gh\n", [])
                == "[\"ab cd\\nef\\n\\ngh\\n\"]")
    test.case("U3C3")
    test.assert(read_as("%TAG !yaml! tag:yaml.org,2002:\n---\n!yaml!str \"foo\"\n", ["!yaml!", "!yaml!str"])
                == "[\"foo\"]")
    test.case("U3XV")
    test.assert(read_as("---\ntop1: &node1\n  &k1 key1: one\ntop2: &node2 # comment\n  key2: two\ntop3:\n  &k3 key3: three\ntop4:\n  &node4\n  &k4 key4: four\ntop5:\n  &node5\n  key5: five\ntop6: &val6\n  six\ntop7:\n  &val7 seven\n",
        [])
                == "[{\"top1\":{\"key1\":\"one\"},\"top2\":{\"key2\":\"two\"},\"top3\":{\"key3\":\"three\"},\"top4\":{\"key4\":\"four\"},\"top5\":{\"key5\":\"five\"},\"top6\":\"six\",\"top7\":\"seven\"}]")
    test.case("U44R")
    test.assert(refused("map:\n  key1: \"quoted1\"\n   key2: \"bad indentation\"\n", []))
    test.case("U99R")
    test.assert(refused("- !!str, xxx\n", ["!!str"]))
    test.case("U9NS")
    test.assert(read_as("---\ntime: 20:03:20\nplayer: Sammy Sosa\naction: strike (miss)\n...\n---\ntime: 20:03:47\nplayer: Sammy Sosa\naction: grand slam\n...\n",
        [])
                == "[{\"time\":\"20:03:20\",\"player\":\"Sammy Sosa\",\"action\":\"strike (miss)\"},{\"time\":\"20:03:47\",\"player\":\"Sammy Sosa\",\"action\":\"grand slam\"}]")
    test.case("UDM2")
    test.assert(read_as("- { url: http://example.org }\n", [])
                == "[[{\"url\":\"http://example.org\"}]]")
    test.case("UDR7")
    test.assert(read_as("sequence: [ one, two, ]\nmapping: { sky: blue, sea: green }\n", [])
                == "[{\"sequence\":[\"one\",\"two\"],\"mapping\":{\"sky\":\"blue\",\"sea\":\"green\"}}]")
    test.case("UGM3")
    test.assert(read_as("--- !<tag:clarkevans.com,2002:invoice>\ninvoice: 34843\ndate   : 2001-01-23\nbill-to: &id001\n    given  : Chris\n    family : Dumars\n    address:\n        lines: |\n            458 Walkman Dr.\n            Suite #292\n        city    : Royal Oak\n        state   : MI\n        postal  : 48046\nship-to: *id001\nproduct:\n    - sku         : BL394D\n      quantity    : 4\n      description : Basketball\n      price       : 450.00\n    - sku         : BL4438H\n      quantity    : 1\n      description : Super Hoop\n      price       : 2392.00\ntax  : 251.42\ntotal: 4443.52\ncomments:\n    Late afternoon is best.\n    Backup contact is Nancy\n    Billsmer @ 338-4338.\n",
        ["!<tag:clarkevans.com,2002:invoice>"])
                == "[{\"invoice\":34843,\"date\":\"2001-01-23\",\"bill-to\":{\"given\":\"Chris\",\"family\":\"Dumars\",\"address\":{\"lines\":\"458 Walkman Dr.\\nSuite #292\\n\",\"city\":\"Royal Oak\",\"state\":\"MI\",\"postal\":48046}},\"ship-to\":{\"given\":\"Chris\",\"family\":\"Dumars\",\"address\":{\"lines\":\"458 Walkman Dr.\\nSuite #292\\n\",\"city\":\"Royal Oak\",\"state\":\"MI\",\"postal\":48046}},\"product\":[{\"sku\":\"BL394D\",\"quantity\":4,\"description\":\"Basketball\",\"price\":450},{\"sku\":\"BL4438H\",\"quantity\":1,\"description\":\"Super Hoop\",\"price\":2392}],\"tax\":251.42,\"total\":4443.52,\"comments\":\"Late afternoon is best. Backup contact is Nancy Billsmer @ 338-4338.\"}]")
    test.case("UKK6/01")
    test.assert(read_as("::\n", [])
                == "[{\":\":null}]")
    test.case("UT92")
    test.assert(read_as("---\n{ matches\n% : 20 }\n...\n---\n# Empty\n...\n", [])
                == "[{\"matches %\":20},null]")
    test.case("UV7Q")
    test.assert(read_as("x:\n - x\n  \tx\n", [])
                == "[{\"x\":[\"x x\"]}]")
    test.case("V55R")
    test.assert(read_as("- &a a\n- &b b\n- *a\n- *b\n", [])
                == "[[\"a\",\"b\",\"a\",\"b\"]]")
    test.case("VJP3/00")
    test.assert(refused("k: {\nk\n:\nv\n}\n", []))
    test.case("VJP3/01")
    test.assert(read_as("k: {\n k\n :\n v\n }\n", [])
                == "[{\"k\":{\"k\":\"v\"}}]")
    test.case("W42U")
    test.assert(read_as("- # Empty\n- |\n block node\n- - one # Compact\n  - two # sequence\n- one: two # Compact mapping\n",
        [])
                == "[[null,\"block node\\n\",[\"one\",\"two\"],{\"one\":\"two\"}]]")
    test.case("W4TN")
    test.assert(read_as("%YAML 1.2\n--- |\n%!PS-Adobe-2.0\n...\n%YAML 1.2\n---\n# Empty\n...\n", [])
                == "[\"%!PS-Adobe-2.0\\n\",null]")
    test.case("W5VH")
    test.assert(read_as("a: &:@*!\$\"<foo>: scalar a\nb: *:@*!\$\"<foo>:\n", [])
                == "[{\"a\":\"scalar a\",\"b\":\"scalar a\"}]")
    test.case("W9L4")
    test.assert(refused("---\nblock scalar: |\n     \n  more spaces at the beginning\n  are invalid\n", []))
    test.case("WZ62")
    test.assert(read_as("{\n  foo : !!str,\n  !!str : bar,\n}\n", ["!!str"])
                == "[{\"foo\":\"\",\"\":\"bar\"}]")
    test.case("X4QW")
    test.assert(refused("block: ># comment\n  scalar\n", []))
    test.case("X8DW")
    test.assert(read_as("---\n? key\n# comment\n: value\n", [])
                == "[{\"key\":\"value\"}]")
    test.case("XLQ9")
    test.assert(read_as("---\nscalar\n%YAML 1.2\n", [])
                == "[\"scalar %YAML 1.2\"]")
    test.case("XV9V")
    test.assert(read_as("Folding:\n  \"Empty line\n\n  as a line feed\"\nChomping: |\n  Clipped empty lines\n \n\n",
        [])
                == "[{\"Folding\":\"Empty line\\nas a line feed\",\"Chomping\":\"Clipped empty lines\\n\"}]")
    test.case("Y2GN")
    test.assert(read_as("---\nkey: &an:chor value\n", [])
                == "[{\"key\":\"value\"}]")
    test.case("Y79Y/000")
    test.assert(refused("foo: |\n\t\nbar: 1\n", []))
    test.case("Y79Y/001")
    test.assert(read_as("foo: |\n \t\nbar: 1\n", [])
                == "[{\"foo\":\"\\t\\n\",\"bar\":1}]")
    test.case("Y79Y/002")
    test.assert(read_as("- [\n\t\n foo\n ]\n", [])
                == "[[[\"foo\"]]]")
    test.case("Y79Y/003")
    test.assert(refused("- [\n\tfoo,\n foo\n ]\n", []))
    test.case("Y79Y/004")
    test.assert(refused("-\t-\n", []))
    test.case("Y79Y/005")
    test.assert(refused("- \t-\n", []))
    test.case("Y79Y/006")
    test.assert(refused("?\t-\n", []))
    test.case("Y79Y/007")
    test.assert(refused("? -\n:\t-\n", []))
    test.case("Y79Y/008")
    test.assert(refused("?\tkey:\n", []))
    test.case("Y79Y/009")
    test.assert(refused("? key:\n:\tkey:\n", []))

@test
fn test_cases_010() [io]
    test.case("Y79Y/010")
    test.assert(read_as("-\t-1\n", [])
                == "[[-1]]")
    test.case("YD5X")
    test.assert(read_as("- [name        , hr, avg  ]\n- [Mark McGwire, 65, 0.278]\n- [Sammy Sosa  , 63, 0.288]\n", [])
                == "[[[\"name\",\"hr\",\"avg\"],[\"Mark McGwire\",65,0.278],[\"Sammy Sosa\",63,0.288]]]")
    test.case("YJV2")
    test.assert(refused("[-]\n", []))
    test.case("Z67P")
    test.assert(read_as("literal: |2\n  value\nfolded: !foo >1\n value\n", ["!foo"])
                == "[{\"literal\":\"value\\n\",\"folded\":\"value\\n\"}]")
    test.case("Z9M4")
    test.assert(read_as("%TAG !e! tag:example.com,2000:app/\n---\n- !e!foo \"bar\"\n", ["!e!", "!e!foo"])
                == "[[\"bar\"]]")
    test.case("ZCZ6")
    test.assert(refused("a: b: c: d\n", []))
    test.case("ZF4X")
    test.assert(read_as("Mark McGwire: {hr: 65, avg: 0.278}\nSammy Sosa: {\n    hr: 63,\n    avg: 0.288\n  }\n", [])
                == "[{\"Mark McGwire\":{\"hr\":65,\"avg\":0.278},\"Sammy Sosa\":{\"hr\":63,\"avg\":0.288}}]")
    test.case("ZH7C")
    test.assert(read_as("&a a: b\nc: &d d\n", [])
                == "[{\"a\":\"b\",\"c\":\"d\"}]")
    test.case("ZK9H")
    test.assert(read_as("{ key: [[[\n  value\n ]]]\n}\n", [])
                == "[{\"key\":[[[\"value\"]]]}]")
    test.case("ZL4Z")
    test.assert(refused("---\na: 'b': c\n", []))
    test.case("ZVH3")
    test.assert(refused("- key: value\n - item1\n", []))
    test.case("ZWK4")
    test.assert(read_as("---\na: 1\n? b\n&anchor c: 3\n", [])
                == "[{\"a\":1,\"b\":null,\"c\":3}]")
    test.case("ZXT5")
    test.assert(refused("[ \"key\"\n  :value ]\n", []))
